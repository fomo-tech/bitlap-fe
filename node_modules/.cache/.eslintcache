            />\n                    <div data-v-4f0a6390=\"\" className=\"action-item\" onClick={() => setOpenSecurity(true)}>\n                        <div data-v-4f0a6390=\"\" className=\"action-left\">\n                            <svg\n                                data-v-4f0a6390=\"\"\n                                className=\"inline-block action-icon\"\n                                viewBox=\"0 0 24 24\"\n                                width=\"1.2em\"\n                                height=\"1.2em\"\n                                style={{ color: \"rgb(7, 193, 96)\" }}\n                            >\n                                <path\n                                    fill=\"currentColor\"\n                                    d=\"m10 17l-4-4l1.41-1.41L10 14.17l6.59-6.59L18 9m-6-8L3 5v6c0 5.55 3.84 10.74 9 12c5.16-1.26 9-6.45 9-12V5z\"\n                                />\n                            </svg>\n                            <span data-v-4f0a6390=\"\">\n                                {t(\"Trung tâm bảo mật\")}\n                            </span>\n                        </div>\n                        <i\n                            data-v-4f0a6390=\"\"\n                            className=\"van-badge__wrapper van-icon van-icon-arrow\"\n                        >\n\n                        </i>\n                    </div>\n                    <SecurityCenter\n                        open={openSecurity}\n                        setOpen={setOpenSecurity}\n                    />\n                    <div data-v-4f0a6390=\"\" className=\"action-item\" onClick={() => setOpenLang(true)}>\n                        <div data-v-4f0a6390=\"\" className=\"action-left\">\n                            <svg\n                                data-v-4f0a6390=\"\"\n                                className=\"inline-block action-icon\"\n                                viewBox=\"0 0 24 24\"\n                                width=\"1.2em\"\n                                height=\"1.2em\"\n                                style={{ color: \"rgb(156, 39, 176)\" }}\n                            >\n                                <path\n                                    fill=\"currentColor\"\n                                    d=\"M22.401 4.818h-9.927L10.927 0H1.599C.72 0 .002.719.002 1.599v16.275c0 .878.72 1.597 1.597 1.597h10L13.072 24H22.4c.878 0 1.597-.707 1.597-1.572V6.39c0-.865-.72-1.572-1.597-1.572zm-15.66 8.68c-2.07 0-3.75-1.68-3.75-3.75s1.68-3.75 3.75-3.75c1.012 0 1.86.375 2.512.976l-.99.952a2.2 2.2 0 0 0-1.522-.584c-1.305 0-2.363 1.08-2.363 2.409S5.436 12.16 6.74 12.16c1.507 0 2.13-1.08 2.19-1.808l-2.188-.002V9.066h3.51c.05.23.09.457.09.764c0 2.147-1.434 3.669-3.602 3.669zm16.757 8.93c0 .59-.492 1.072-1.097 1.072h-8.875l3.649-4.03h.005l-.74-2.302l.006-.005s.568-.488 1.277-1.24c.712.771 1.63 1.699 2.818 2.805l.771-.772c-1.272-1.154-2.204-2.07-2.89-2.805c.919-1.087 1.852-2.455 2.049-3.707h2.034v.002h.002v-.94h-4.532v-1.52h-1.471v1.52H14.3l-1.672-5.21l.006.022h9.767c.605 0 1.097.48 1.097 1.072zm-6.484-7.311c-.536.548-.943.873-.943.873l-.008.004l-1.46-4.548h4.764c-.307 1.084-.988 2.108-1.651 2.904c-1.176-1.392-1.18-1.844-1.18-1.844h-1.222s.05.678 1.7 2.61z\"\n                                />\n                            </svg>\n                            <span data-v-4f0a6390=\"\">\n                                {t(\"Ngôn ngữ\")}\n                            </span>\n                        </div>\n                        <div data-v-4f0a6390=\"\" className=\"action-right\">\n                            {\n                                i18n.language === 'vi' &&\n                                <span data-v-4f0a6390=\"\" className=\"action-value\">\n                                    Tiếng Việt\n                                </span>\n                            }\n                            {\n                                i18n.language === 'en' &&\n                                <span data-v-4f0a6390=\"\" className=\"action-value\">\n                                    English\n                                </span>\n                            }\n                            {\n                                i18n.language === 'zh' &&\n                                <span data-v-4f0a6390=\"\" className=\"action-value\">\n                                    中文\n                                </span>\n                            }\n                            <i\n                                data-v-4f0a6390=\"\"\n                                className=\"van-badge__wrapper van-icon van-icon-arrow\"\n                            >\n\n                            </i>\n                        </div>\n                    </div>\n                    <DrawerLang openLang={openLang} setOpenLang={setOpenLang} />\n                    <div data-v-4f0a6390=\"\" className=\"action-item\" onClick={() => window.$crisp?.push([\"do\", \"chat:open\"])}>\n                        <div data-v-4f0a6390=\"\" className=\"action-left\">\n                            <svg\n                                data-v-4f0a6390=\"\"\n                                className=\"inline-block action-icon\"\n                                viewBox=\"0 0 24 24\"\n                                width=\"1.2em\"\n                                height=\"1.2em\"\n                                style={{ color: \"rgb(33, 150, 243)\" }}\n                            >\n                                <path\n                                    fill=\"currentColor\"\n                                    d=\"M12 1c-5 0-9 4-9 9v7a3 3 0 0 0 3 3h3v-8H5v-2a7 7 0 0 1 7-7a7 7 0 0 1 7 7v2h-4v8h4v1h-7v2h6a3 3 0 0 0 3-3V10c0-5-4.03-9-9-9\"\n                                />\n                            </svg>\n                            <span data-v-4f0a6390=\"\">\n                                {t(\"Dịch vụ khách hàng\")}\n                            </span>\n                        </div>\n                        <i\n                            data-v-4f0a6390=\"\"\n                            className=\"van-badge__wrapper van-icon van-icon-arrow\"\n                        >\n                            {/**/}\n                            {/**/}\n                            {/**/}\n                        </i>\n                    </div>\n                    {/**/}\n                </div>\n                <div data-v-4f0a6390=\"\" className=\"action-group\">\n                    <div data-v-4f0a6390=\"\" className=\"action-item logout\">\n                        <div data-v-4f0a6390=\"\" className=\"action-left\" onClick={handleLogout}>\n                            <svg\n                                data-v-4f0a6390=\"\"\n                                className=\"inline-block action-icon\"\n                                viewBox=\"0 0 24 24\"\n                                width=\"1.2em\"\n                                height=\"1.2em\"\n                                style={{ color: \"rgb(244, 67, 54)\" }}\n                            >\n                                <path\n                                    fill=\"currentColor\"\n                                    d=\"m17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5M4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4z\"\n                                />\n                            </svg>\n                            <span data-v-4f0a6390=\"\">\n                                {t(\"Đăng xuất\")}\n                            </span>\n                        </div>\n                        <i\n                            data-v-4f0a6390=\"\"\n                            className=\"van-badge__wrapper van-icon van-icon-arrow\"\n                        >\n                            {/**/}\n                            {/**/}\n                            {/**/}\n                        </i>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n    )\n}\n\nexport default Profile","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/order/index.tsx",["268","269","270"],[],"import { DotLottieReact } from '@lottiefiles/dotlottie-react'\nimport { Progress } from 'antd'\nimport requestService from 'api/request'\nimport clsx from 'clsx'\nimport Empty from 'components/elements/Empty'\nimport RecordOrders from 'components/ui/RecordOrders'\nimport { formatTime } from 'lib/helpers'\nimport React, { useEffect, useState } from 'react'\nimport Countdown from 'react-countdown'\nimport { useTranslation } from 'react-i18next'\n\nconst Order = () => {\n    const [orders, setOrders] = useState([])\n    const [openRecord, setOpenRecord] = useState(false)\n    const { t, i18n } = useTranslation()\n    const getOrders = async () => {\n        try {\n            const res = await requestService.get('/tickets/orders')\n            if (res && res.data) {\n                setOrders(res.data?.data)\n            }\n        } catch (error) {\n            console.log('====================================');\n            console.log(error);\n            console.log('====================================');\n        }\n    }\n\n\n    const remainingPercent = (i: any) => {\n        const now = Date.now();\n        const createdAt = new Date(i?.createdAt).getTime();\n        const totalTime = i?.ticket?.earningDay * 24 * 60 * 60 * 1000;\n        const elapsedTime = now - createdAt;\n\n        return Math.min(100, (elapsedTime * 100) / totalTime);\n    };\n\n\n\n    useEffect(() => {\n        getOrders();\n        const intervalId = setInterval(() => {\n            getOrders();\n        }, 5000);\n        return () => clearInterval(intervalId);\n    }, []);\n    return (\n        <div data-v-cde322bf=\"\" data-v-e697ea1f=\"\" className=\"nft-list-page\">\n\n            <div data-v-cde322bf=\"\" className=\"page-content !pt-0\">\n                <div data-v-cde322bf=\"\" className=\"nft-grid\" >\n                    {\n                        orders?.length !== 0 &&\n                        orders?.map((i: any) => (\n                            <div data-v-cde322bf=\"\" className=\"nft-item\" key={i?._id}>\n                                <div data-v-cde322bf=\"\" className=\"nft-header\">\n                                    <div data-v-cde322bf className='task-button-wrapper'>\n                                        <button data-v-cde322bf className='task-button'>\n                                            Active\n                                        </button>\n                                    </div>\n                                    <div data-v-cde322bf=\"\" className={clsx(\"nft-image\", {\n                                        \"normal\": i?.ticket?.vip === 1,\n                                        \"rare\": i?.ticket?.vip === 2,\n                                        \"epic\": i?.ticket?.vip === 3,\n                                        \"legendary\": i?.ticket?.vip === 4,\n                                        \"mythic\": i?.ticket?.vip === 5,\n                                    })}>\n                                        <div data-v-cde322bf=\"\" className=\"van-image flex items-center justify-center p-1\" >\n                                            <img\n                                                src={`${process.env.REACT_APP_BASE_URL}` + i?.ticket?.urlImage}\n                                                alt=\"Vé vàng NFT\"\n                                                className=\"van-image__img\"\n                                                style={{ objectFit: \"cover\" }}\n                                            />\n                                            {/**/}\n                                            {/**/}\n                                        </div>\n                                    </div>\n                                    <div className='flex justify-center items-center'>\n                                        <Progress type=\"circle\" status=\"active\" percent={remainingPercent(i)} strokeColor={{\n                                            '0%': '#9ce33a',\n                                            '100%': '#2a7d06'\n                                        }}\n                                            format={(p) => <div>\n                                                <div className='text-[10px] text-center'>\n                                                    {t(\"Thời gian còn lại\")}\n                                                </div>\n                                                {\n                                                    <Countdown date={new Date(i?.createdAt)?.getTime() + i?.ticket?.earningDay * 1000 * 60 * 60 * 24}\n                                                        renderer={({ days, hours, minutes, seconds, completed }) => {\n                                                            if (completed) {\n\n                                                                return <div>Expired</div>;\n                                                            } else {\n                                                                return <span className='text-[10px] font-[900] text-[#151515]'>{days} {t(\"home.day\")} {hours}:{minutes}:{seconds}</span>;\n                                                            }\n                                                        }}\n                                                    />\n                                                }\n                                            </div>}\n\n                                        />\n                                    </div>\n                                </div>\n                                <div data-v-cde322bf=\"\" className='nft-info p-2'>\n                                    <div data-v-cde322bf=\"\" className='nft-name'>\n                                        {i?.ticket?.name}\n                                    </div>\n                                    <div data-v-cde322bf=\"\" className='nft-rate'>\n                                        <div data-v-cde322bf=\"\" className='label'>\n                                            {t(\"Thời gian trả thu nhập\")}\n                                        </div>\n                                        <div data-v-cde322bf=\"\" className='value-wrapper'>\n                                            {new Date(i?.rewardTime)?.toLocaleString()}\n                                        </div>\n                                        <div data-v-cde322bf=\"\" className='value ml-2'>\n                                            +{i?.ticket?.incomePerDay}$\n                                        </div>\n                                    </div>\n                                    <div data-v-cde322bf=\"\" className='nft-rate'>\n                                        <div data-v-cde322bf=\"\" className='label'>\n                                            {t(\"Thu nhập hiện tại\")}\n                                        </div>\n\n                                        <div data-v-cde322bf=\"\" className='value ml-2'>\n                                            +{i?.currentIncome?.toFixed(5)}$\n                                        </div>\n                                    </div>\n                                    <div data-v-cde322bf=\"\" className='nft-details'>\n                                        <div data-v-cde322bf=\"\" className='detail-row'>\n                                            <div data-v-cde322bf=\"\" className='detail-item'>\n                                                <div data-v-cde322bf=\"\" className='label'>\n                                                    {t(\"Ngày mua\")}\n                                                </div>\n                                                <div data-v-cde322bf=\"\" className='value'>\n                                                    {new Date(i?.createdAt)?.toLocaleString()}\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div data-v-cde322bf=\"\" className='nft-details'>\n                                        <div data-v-cde322bf=\"\" className='detail-row'>\n                                            <div data-v-cde322bf=\"\" className='detail-item'>\n                                                <div data-v-cde322bf=\"\" className='label'>\n                                                    {t(\"Giá mua\")}\n                                                </div>\n                                                <div data-v-cde322bf=\"\" className='value'>\n                                                    {i?.ticket?.price?.toLocaleString()}$\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n\n\n                            </div>\n                        ))\n\n                    }\n                </div>\n                {\n                    orders?.length === 0 && <Empty title={t('order.no_empty_ticket')} />\n                }\n\n\n                <div data-v-cde322bf=\"\" className=\"float-button\" onClick={() => setOpenRecord(true)}>\n                    <i\n                        data-v-cde322bf=\"\"\n                        className=\"van-badge__wrapper van-icon van-icon-records records-icon\"\n                    >\n                        {/**/}\n                        {/**/}\n                        {/**/}\n                    </i>\n                    <span data-v-cde322bf=\"\">{t(\"Hồ sơ giao dịch\")}</span>\n                </div>\n            </div>\n            <RecordOrders\n                open={openRecord}\n                setOpen={setOpenRecord}\n            />\n\n        </div>\n\n    )\n}\n\nexport default Order","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/home/index.tsx",["271","272","273","274","275","276","277","278","279"],[],"import React, { useEffect, useState } from 'react'\nimport { Swiper, SwiperSlide } from \"swiper/react\";\nimport { Autoplay } from 'swiper/modules';\nimport banner1 from 'assets/images/banner1.png'\nimport banner2 from 'assets/images/banner2.png'\nimport banner3 from 'assets/images/banner3.png'\nimport requestService from 'api/request';\nimport { useTranslation } from 'react-i18next';\nimport { useGlobalAppStore } from 'store/useGlobalApp';\nimport { Drawer, message, Modal } from 'antd';\nimport { useAuthApp } from 'store/useAuthApp';\nimport Countdown from 'react-countdown';\nimport QuickAction from 'components/ui/QuickAction';\nimport NutientBanner from 'components/ui/home/NutientBanner';\nimport telegram from 'assets/icons/telegram.png'\nimport clsx from 'clsx';\nimport PopupWelcome from 'components/ui/home/PopupWelcome';\nimport Marquee from 'react-fast-marquee';\nconst HomePage = () => {\n    const [tickets, setTickets] = useState([])\n    const { loading, handleLoading, handleCallbackUser } = useGlobalAppStore()\n    const { user } = useAuthApp()\n    const { t, i18n } = useTranslation();\n    const [openConfirm, setOpenConfirm] = useState<any>(false)\n    const [run, setRun] = useState(true);\n    const [marqueeKey, setMarqueeKey] = useState(0);\n\n\n    const handleBuyTicket = async (ticketId: string) => {\n        handleLoading(true)\n        try {\n            const res = await requestService.post('/tickets', {\n                data: {\n                    ticketId\n                }\n            })\n            if (res && res.data) {\n                message.success(res.data?.message)\n                handleCallbackUser()\n                setOpenConfirm(false)\n            }\n        } catch (error: any) {\n            message.error(error?.response?.data?.message)\n        }\n        handleLoading(false)\n    }\n    const getTickets = async () => {\n        try {\n            const res = await requestService.get('/tickets')\n            if (res && res.data) {\n                setTickets(res.data?.data)\n            }\n        } catch (error) {\n            console.log('====================================');\n            console.log(error);\n            console.log('====================================');\n        }\n    }\n    function getRandomId(existingIds: any) {\n        let id;\n        do {\n            id = Math.floor(10000 + Math.random() * 30000); // Tạo id từ 23000 đến 23999\n        } while (existingIds.has(id));\n        existingIds.add(id);\n        return id;\n    }\n\n    function getRandomAmount() {\n        return `${Math.floor(Math.random() * 10) * 10 + 30}$`; // Bước nhảy 50$, từ 50$ đến 500$\n    }\n\n    function generateRandomObjects(count: number) {\n        const objects = [];\n        const existingIds = new Set();\n\n        for (let i = 0; i < count; i++) {\n            objects.push({\n                id: getRandomId(existingIds),\n                amount: getRandomAmount(),\n                type: Math.random() < 0.5 ? t('home.deposit') : t('home.withdraw')\n            });\n        }\n\n        return objects;\n    }\n    useEffect(() => {\n        getTickets()\n    }, [])\n    return (\n        <>\n            {/* <PopupWelcome /> */}\n            <div className='fixed z-[9999] bottom-[80px] right-[20px]'>\n                <a href='https://t.me/duck_earning' target='_blank' >\n                    <img src={telegram} className='w-[48px]' />\n                </a>\n            </div>\n            {/* Baner */}\n\n            <div className='h-[42vw] m-[3vw] rounded-lg overflow-hidden'\n                style={{\n                    boxShadow: \"0 .53333vw 3.2vw #64656614\"\n                }}\n            >\n                <Swiper className=\"mySwiper\" autoplay={{\n                    delay: 2500,\n                    disableOnInteraction: false,\n\n                }}\n                    loop\n                    modules={[Autoplay]}\n                >\n                    <SwiperSlide>\n                        <img src={banner2} alt='banner1' className='object-contain w-full h-full' />\n                    </SwiperSlide>\n                    <SwiperSlide className='object-contain w-full h-full'>\n                        <img src={banner3} alt='banner1' className='object-contain w-full h-full' />\n                    </SwiperSlide>\n                    <SwiperSlide>\n                        <img src={banner1} alt='banner1' className='object-contain w-full h-full' />\n                    </SwiperSlide>\n                </Swiper>\n            </div>\n\n\n            {/* Notice */}\n\n            <div className='notice-bar'>\n                <div className='van-notice-bar'>\n                    <div className=\"size-6\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-6\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z\" />\n                        </svg>\n                    </div>\n                    <div className='van-notice-bar__wrap'>\n                        {/* <Swiper autoplay={{\n                            delay: 2500,\n                            disableOnInteraction: false,\n                        }}\n                            modules={[Autoplay]}\n                            direction='vertical'\n                            loop={true}\n                            slidesPerView={1}\n                            style={{\n                                height: \"50px\"\n                            }}\n                        >\n                            {generateRandomObjects(10).map((item) => (\n                                <SwiperSlide key={item.id} style={{\n                                    height: \"50px\"\n                                }}>\n                                    <div className='h-full w-full flex\n                                    items-center'>ID: {item.id} {item.type} {item.amount}</div>\n                                </SwiperSlide>\n                            ))}\n                        </Swiper> */}\n                        <Marquee className='text-[14px]' gradient={false} pauseOnHover speed={40} delay={1} >\n                            {\n                                i18n?.language === 'vi' && <div>\n                                    <span className='font-[900] text-red-600'>\n                                        &nbsp;   &nbsp;  &nbsp;   &nbsp; &nbsp; Thông báo:&nbsp; \n                                    </span>\n                                    Chỉ giải quyết rút tiền từ 9:00 - 23:00  từ Thứ 2 - Thứ 6. Xin cám ơn 😘😘😘\n                                </div>\n                            }\n                            {\n                                i18n?.language === 'en' && <div>\n                                    <span className='font-[900] text-red-600'>\n                                        &nbsp;   &nbsp;  &nbsp;   &nbsp; &nbsp;  Announcement: &nbsp;\n                                    </span>Withdrawals are processed from 9:00 to 23:00, Monday to Friday 😘😘😘\n                                </div>\n                            }\n                            {\n                                i18n?.language === 'zh' && <div>\n                                    <span className='font-[900] text-red-600'>\n                                        &nbsp;   &nbsp;  &nbsp;   &nbsp; &nbsp; Announcement:&nbsp;\n                                    </span> 公告：提款时间为周一至周五的 9:00 至 23:00 😘😘😘\n                                </div>\n                            }\n                        </Marquee>\n\n\n                    </div>\n                </div>\n            </div>\n\n            <QuickAction />\n\n            <NutientBanner />\n\n            {/* nft-section */}\n            <div className='nft-section pb-[50px]' data-v-caee1139>\n                <div data-v-caee1139=\"\" className=\"nft-list\">\n                    {\n                        tickets.map((i: any) => (\n                            <div data-v-caee1139=\"\" className=\"nft-card \">\n                                <div data-v-caee1139=\"\" className=\"nft-image\">\n                                    <div data-v-caee1139=\"\" className=\"van-image animation-bounceCard\" style={{ width: 180 }}>\n                                        <img\n                                            src={`${process.env.REACT_APP_BASE_URL}` + i?.urlImage}\n                                            alt=\"Vé vàng NFT\"\n                                            className=\"van-image__img\"\n                                            style={{ objectFit: \"cover\" }}\n                                        />\n                                        {/**/}\n                                        {/**/}\n                                    </div>\n                                    <div data-v-caee1139=\"\" className=\"nft-badges\">\n                                        <div data-v-caee1139=\"\" className=\"new\" />\n                                    </div>\n                                    <div data-v-caee1139=\"\" className=\"nft-tags\">\n                                        <div data-v-caee1139=\"\" className=\"tag-item rate-tag\">\n\n                                            <span\n                                                data-v-caee1139=\"\"\n                                                className=\"van-tag van-tag--round van-tag--warning\"\n                                            >\n                                                {/* {t(\"home.discount\")}: 4% */}\n                                                {t(\"home.order\")}: {i?.order || 0}\n                                            </span>\n                                        </div>\n                                        <div data-v-caee1139=\"\" className=\"tag-item restrict-tag\">\n                                            <span\n                                                data-v-caee1139=\"\"\n                                                className=\"van-tag van-tag--medium van-tag--warning\"\n                                            >\n                                                {t(\"home.amount\")}  {i?.inventory} {/**/}\n                                            </span>\n                                        </div>\n                                        <div data-v-caee1139=\"\" className=\"tag-item cycle-tag\">\n                                            <span\n                                                data-v-caee1139=\"\"\n                                                className=\"van-tag van-tag--round van-tag--warning\"\n                                            >\n                                                {i?.earningDay} {t(\"home.day\")}\n                                            </span>\n                                        </div>\n                                    </div>\n\n                                </div>\n                                <div data-v-caee1139=\"\" className=\"nft-footer\">\n                                    <div data-v-caee1139=\"\" className=\"nft-info\">\n                                        <div data-v-caee1139=\"\" className=\"nft-title\">\n                                            <span data-v-caee1139=\"\" className=\"name\">\n                                                {i?.name}\n                                            </span>\n                                        </div>\n                                        <div data-v-caee1139=\"\" className=\"countdown-wrapper\">\n                                            <span data-v-caee1139=\"\" className=\"label\">\n                                                {t(\"home.expiration_time\")}：\n                                            </span>\n                                            <div data-v-caee1139=\"\" role=\"timer\" className=\"van-count-down\">\n                                                <Countdown date={new Date(i?.soldOutAt)?.getTime()}\n                                                    renderer={({ days, hours, minutes, seconds, completed }) => {\n                                                        if (completed) {\n\n                                                            return <div>Expired</div>;\n                                                        } else {\n                                                            return <span>{days} {t(\"home.day\")} {hours}:{minutes}:{seconds}</span>;\n                                                        }\n                                                    }}\n                                                />\n                                            </div>\n                                        </div>\n                                        <div data-v-caee1139=\"\" className=\"nft-price\">\n                                            <span data-v-caee1139=\"\" className=\"price-label\">\n                                                {t(\"home.price\")}\n                                            </span>\n                                            <span data-v-caee1139=\"\" className=\"price-value\">\n                                                {i?.price}$\n                                            </span>\n                                        </div>\n                                        <div data-v-caee1139=\"\" className=\"nft-earnings\">\n                                            <div data-v-caee1139=\"\" className=\"earnings-item\">\n                                                <span data-v-caee1139=\"\" className=\"label\">\n                                                    {t(\"home.daily_income\")}\n                                                </span>\n                                                <span data-v-caee1139=\"\" className=\"value\">\n                                                    +{i?.incomePerDay} $\n                                                </span>\n                                            </div>\n                                            <div data-v-caee1139=\"\" className=\"earnings-item\">\n                                                <span data-v-caee1139=\"\" className=\"label\">\n                                                    {t(\"home.total_revenue\")}\n                                                </span>\n                                                <span data-v-caee1139=\"\" className=\"value\">\n                                                    {i?.price + i?.incomePerDay * i?.earningDay} $\n                                                </span>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <button\n                                        data-v-caee1139=\"\"\n                                        disabled={!user || user.realBalance < i?.price}\n                                        type=\"button\"\n                                        onClick={() => setOpenConfirm(i)}\n                                        className={clsx(\"w-full rounded-md text-[#fff] van-button van-button--primary van-button--small van-button--block\", {\n\n                                        })}\n                                        style={{\n                                            background: !user || user.realBalance < i?.price ? \"#bbb\" : \"\"\n                                        }}\n                                    >\n                                        <div className=\"van-button__content\">\n                                            {/**/}\n                                            <span className=\"van-button__text\">\n                                                {!user || user.realBalance < i?.price ? t(\"Insufficient balance\") : t(\"home.buy_now\")}\n                                            </span>\n                                            {/**/}\n                                        </div>\n                                    </button>\n                                </div>\n                            </div>\n                        ))\n                    }\n                </div>\n            </div>\n\n            <Drawer\n                className='modal-confirm-buy'\n                placement='bottom'\n                height={\"40vh\"}\n                closable={false}\n                onClose={() => setOpenConfirm(false)}\n                zIndex={9999}\n                title={\n                    <div className='flex justify-between'>\n                        <div className='text-center font-[900] text-[18px]'>\n                            {t(\"Xác nhận\")}\n                        </div>\n                        <button className='text-yellow-700 underline text-[15px] font-[500]'\n                            onClick={() => setOpenConfirm(false)}\n                        >\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-6\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\" />\n                            </svg>\n\n                        </button>\n\n                    </div>\n                }\n                open={openConfirm}\n            >\n                <div className='flex flex-col gap-2 my-3 px-3'>\n                    <div className='flex w-full items-center justify-between'>\n                        <div>\n                            {t(\"Tên Ticket\")}\n                        </div>\n                        <div className='text-[15px] font-[900]'>\n                            {openConfirm?.name}\n                        </div>\n                    </div>\n                    <div className='flex w-full items-center justify-between'>\n                        <div>\n                            Vip\n                        </div>\n                        <div className='text-[15px] font-[900]'>\n                            {openConfirm?.vip}\n                        </div>\n                    </div>\n                    <div className='flex w-full items-center justify-between'>\n                        <div>\n                            {t(\"Giá\")}\n                        </div>\n                        <div className='text-[15px] font-[900]'>\n                            {openConfirm?.price}$\n                        </div>\n                    </div>\n                    <div className='flex w-full items-center justify-between'>\n                        <div>\n                            {t(\"home.daily_income\")}\n                        </div>\n                        <div className='text-[15px] font-[900]'>\n                            {openConfirm?.incomePerDay}$\n                        </div>\n                    </div>\n                    <div className='flex w-full items-center justify-between'>\n                        <div>\n                            {t(\"home.day\")}\n                        </div>\n                        <div className='text-[15px] font-[900]'>\n                            {openConfirm?.earningDay}\n                        </div>\n                    </div>\n                </div>\n                <div className='flex w-full items-center justify-between py-4'>\n\n                    <button className='buy-btn w-full'\n                        onClick={() => handleBuyTicket(openConfirm)}\n                        disabled={loading}\n                    >{t(\"Xác nhận\")}</button>\n                </div>\n            </Drawer>\n\n        </>\n    )\n}\n\nexport default HomePage",[],"/Users/nguyenthanhloc/Documents/investment-fe/src/pages/auth/index.tsx",[],[],"/Users/nguyenthanhloc/Documents/investment-fe/src/pages/vip/Vip.tsx",["280"],[],"import requestService from 'api/request'\nimport VipReward from 'components/ui/VipReward'\nimport { formatNumber } from 'lib/helpers'\nimport React, { useEffect, useState } from 'react'\nimport { useTranslation } from 'react-i18next'\nimport { useNavigate } from 'react-router-dom'\nimport { useAuthApp } from 'store/useAuthApp'\nimport { useGlobalAppStore } from 'store/useGlobalApp'\nimport { RulesTranlate } from './RulesTranlate'\n\nconst Vip = () => {\n    const navigate = useNavigate()\n    const { user } = useAuthApp()\n\n    const [openVipReward, setOpenVipReward] = useState(false)\n    const [data, setData] = useState<any>(null)\n    const {t} = useTranslation()\n\n    const getVipInfo = async () => {\n        try {\n            const res = await requestService.get('/profile/vip-info')\n            if (res && res.data) {\n                setData(res.data?.data)\n            }\n        } catch (error) {\n            console.log(error);\n\n        }\n    }\n\n    useEffect(() => {\n        getVipInfo()\n    }, [])\n\n\n    return (\n        <div data-v-f443897c=\"\" className=\"vip-page\">\n            <div data-v-f443897c=\"\" className=\"nav-bar\">\n                <div data-v-f443897c=\"\" className=\"nav-left\"\n                    onClick={() => navigate(-1)}\n                >\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-6 cursor-pointer text-[#fff] hover:text-[#fff]\">\n                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15.75 19.5 8.25 12l7.5-7.5\" />\n                    </svg>\n                </div>\n                <div data-v-f443897c=\"\" className=\"nav-title\">\n                    VIP\n                </div>\n                <div data-v-f443897c=\"\" className=\"nav-right\" />\n            </div>\n            <div data-v-f443897c=\"\" className=\"vip-header\">\n                <div data-v-f443897c=\"\" className=\"vip-card\">\n                    <div data-v-f443897c=\"\" className=\"vip-info\">\n                        <div data-v-f443897c=\"\" className=\"current-level\">\n                            <span data-v-f443897c=\"\" className=\"label\">\n                                {t(\"Current level\")}\n                            </span>\n                            <span data-v-f443897c=\"\" className=\"level\">\n                                VIP {user?.vip}\n                            </span>\n                        </div>\n                        <div data-v-f443897c=\"\" className=\"invite-progress\">\n                            <div data-v-f443897c=\"\" className=\"progress-info\">\n                                <span data-v-f443897c=\"\">\n                                    {t(\"Invitation progress\")}\n                                </span>\n                                <span data-v-f443897c=\"\">{data?.progress}/{data?.vipLevelUp?.invite_num}</span>\n                            </div>\n                            <div data-v-f443897c=\"\" className=\"progress-track\">\n                                <div\n                                    data-v-f443897c=\"\"\n                                    className=\"progress-fill\"\n                                    style={{ width: `${data?.progress * 100 / data?.vipLevelUp?.invite_num}%` }}\n                                />\n                            </div>\n                            <div data-v-f443897c=\"\" className=\"action-buttons\">\n                                <button\n                                    data-v-f443897c=\"\"\n                                    type=\"button\"\n                                    className=\"van-button van-button--primary van-button--small\"\n                                    onClick={() => setOpenVipReward(true)}\n                                >\n                                    <div className=\"van-button__content\">\n                                        <i className=\"van-badge__wrapper van-icon van-icon-cash-back van-button__icon\">\n                                            {/**/}\n                                            {/**/}\n                                            {/**/}\n                                        </i>\n                                        <span className=\"van-button__text\">\n                                            {t(\"View reward\")}\n                                        </span>\n                                        {/**/}\n                                    </div>\n                                </button>\n                            </div>\n                        </div>\n                        <VipReward\n                            open={openVipReward}\n                            setOpen={setOpenVipReward}\n                            vipInfo={data?.vipInfo}\n                            progress={data?.progress}\n                        />\n                    </div>\n                    <div data-v-f443897c=\"\" className=\"vip-benefits\">\n                        <div data-v-f443897c=\"\" className=\"benefit-item\">\n                            <span data-v-f443897c=\"\" className=\"value\">\n                                {data?.progress || 0}\n                            </span>\n                            <span data-v-f443897c=\"\" className=\"label \">\n                                {t(\"Total Invited\")}\n                            </span>\n                        </div>\n                        <div data-v-f443897c=\"\" className=\"benefit-item\">\n                            <span data-v-f443897c=\"\" className=\"value\">\n                                {formatNumber(user?.totalDep)}\n                            </span>\n                            <span data-v-f443897c=\"\" className=\"label\">\n                                {t(\"Total deposit\")}\n                            </span>\n                        </div>\n                        <div data-v-f443897c=\"\" className=\"benefit-item\">\n                            <span data-v-f443897c=\"\" className=\"value\">\n                                {formatNumber(user?.totalReceiveSalary)}\n                            </span>\n                            <span data-v-f443897c=\"\" className=\"label\">\n                                {t(\"Total Receive\")}\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <RulesTranlate/>\n        </div>\n\n    )\n}\n\nexport default Vip","/Users/nguyenthanhloc/Documents/investment-fe/src/configs/index.ts",[],[],"/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/DrawerLang.tsx",[],[],"/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/AddPaymentMethod.tsx",["281","282","283","284","285","286"],[],"import { Drawer, List, message, Modal, Typography } from 'antd'\nimport requestService from 'api/request';\nimport clsx from 'clsx';\nimport React, { useState } from 'react'\nimport { SubmitHandler, useForm } from 'react-hook-form';\nimport { useTranslation } from 'react-i18next';\nimport { useAuthApp } from 'store/useAuthApp';\nimport { useGlobalAppStore } from 'store/useGlobalApp';\n\n\ninterface Props {\n    setOpen: (val: boolean) => void,\n    open: boolean\n}\n\ninterface IFormInput {\n    nameBank: string;\n    numberBank: string;\n    holderName: string\n}\nexport const AddPaymentMethod = ({ open, setOpen }: Props) => {\n    const { i18n, t } = useTranslation();\n    const [openSelectBank, setOpenSelectbank] = useState(false)\n    const { user } = useAuthApp()\n    const { configApp, handleLoading, handleCallbackUser } = useGlobalAppStore()\n    const { register, handleSubmit, watch, control, setValue, reset, formState: { errors } } = useForm<IFormInput>({\n    });\n\n    const onSubmit: SubmitHandler<IFormInput> = async (data) => {\n        handleLoading(true)\n        try {\n            const res = await requestService.post('/profile/method-payment', {\n                data: {\n                    ...data\n                }\n            })\n\n            if (res && res.data) {\n                handleCallbackUser()\n                reset()\n            }\n        } catch (error: any) {\n            message.error(error.response?.data?.message)\n        }\n        handleLoading(false)\n    }\n\n    const handleDeleteMethod = async (item: any) => {\n        try {\n            const res = await requestService.delete('/profile/method-payment', {\n                data: {\n                    ...item\n                }\n            })\n            if (res && res.data) {\n                handleCallbackUser()\n            }\n        } catch (error) {\n            console.log('====================================');\n            console.log(error);\n            console.log('====================================');\n        }\n    }\n\n    return (\n        <>\n            <Drawer\n                open={openSelectBank}\n                placement='bottom'\n                height={\"40vh\"}\n                width={\"100vw\"}\n                zIndex={9999}\n                closeIcon={false}\n                title={\n                    <div className='flex justify-between'>\n                        <div className='cursor-pointer text-[#ccc]' onClick={() => {\n                            setOpenSelectbank(false)\n                            setValue('nameBank', \"\")\n                        }}>\n                            Cancel\n                        </div>\n                        <div className='cursor-pointer van-picker__confirm' onClick={() => {\n                            setOpenSelectbank(false)\n                        }}>\n                            Confirm\n                        </div>\n                    </div>\n                }\n            >\n                <List\n                    header={null}\n                    footer={null}\n\n                    dataSource={configApp?.bankList || []}\n                    renderItem={(item: any) => (\n                        <List.Item onClick={() => setValue('nameBank', item?.value)}>\n                            <div className='text-center w-full cursor-pointer'>\n                                {item?.value}\n                            </div>\n                        </List.Item>\n                    )}\n                />\n            </Drawer>\n\n            <Drawer\n                title={\n                    <div className='text-center'>\n                        Bank\n                    </div>\n                }\n                placement={'right'}\n                width={\"100vw\"}\n                closable={true}\n                closeIcon={\n                    <div>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5 hover:text-[#000]\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15.75 19.5 8.25 12l7.5-7.5\" />\n                        </svg>\n\n\n                    </div>\n                }\n                onClose={() => setOpen(false)}\n\n                open={open}\n\n            >\n                <div data-v-1ad66f02=\"\" className=\"bank-page mt-0\">\n\n                    <div data-v-1ad66f02=\"\" className=\"bank-list\">\n                        {\n                            user && user?.bankList?.length > 0 &&\n                            user.bankList.map((i, index) => (\n                                <div data-v-1ad66f02=\"\" className=\"bank-item\">\n                                    <div data-v-1ad66f02=\"\" className=\"bank-info\">\n                                        <div data-v-1ad66f02=\"\" className=\"info-row\">\n                                            <span data-v-1ad66f02=\"\" className=\"value\">\n                                                {i.numberBank}({i.nameBank})\n                                            </span>\n                                        </div>\n                                    </div>\n                                    <div data-v-1ad66f02=\"\" className=\"bank-actions\">\n                                        <button\n                                            onClick={() => handleDeleteMethod(i)}\n                                            data-v-1ad66f02=\"\"\n                                            type=\"button\"\n                                            className=\"van-button van-button--danger van-button--small van-button--round\"\n                                        >\n                                            <div className=\"van-button__content\">\n                                                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5 text-red-600 cursor-pointer\">\n                                                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0\" />\n                                                </svg>\n\n                                            </div>\n                                        </button>\n                                    </div>\n                                </div>\n                            ))\n                        }\n\n\n                    </div>\n\n                    <div data-v-1ad66f02=\"\" className=\"add-bank-form\">\n                        <div data-v-1ad66f02=\"\" className=\"form-title\">\n                            {t(\"Add New Account\")}\n                        </div>\n                        <form data-v-1ad66f02=\"\" className=\"van-form\" onSubmit={handleSubmit(onSubmit)}>\n                            <div data-v-1ad66f02=\"\" className=\"van-cell van-field\">\n                                {/**/}\n                                <div className=\"van-cell__title van-field__label\">\n                                    <label\n                                        id=\"van-field-26-label\"\n                                        htmlFor=\"van-field-26-input\"\n                                        data-allow-mismatch=\"attribute\"\n                                    >\n                                        {t(\"holderName\")}\n                                    </label>\n                                    {/**/}\n                                </div>\n                                <div className=\"van-cell__value van-field__value\">\n                                    <div className=\"van-field__body\">\n                                        <input\n                                            type=\"text\"\n                                            id=\"van-field-26-input\"\n                                            className=\"van-field__control\"\n                                            placeholder={t(\"Enter your name\")}\n                                            aria-labelledby=\"van-field-26-label\"\n                                            data-allow-mismatch=\"attribute\"\n                                            {...register(\"holderName\", {\n                                                required: t(\"field_required\"),\n\n                                            })}\n                                        />\n                                    </div>\n\n                                </div>\n\n                            </div>\n                            {errors.holderName && <p className='pl-2 text-red-600 text-[12px]'>{errors.holderName.message}</p>}\n                            <div\n                                data-v-1ad66f02=\"\"\n                                className=\"van-cell van-cell--clickable van-field\"\n                                role=\"button\"\n                                tabIndex={0}\n                            >\n                                {/**/}\n                                <div className=\"van-cell__title van-field__label\">\n                                    <label\n                                        id=\"van-field-28-label\"\n                                        htmlFor=\"van-field-28-input\"\n                                        data-allow-mismatch=\"attribute\"\n                                    >\n                                        {t(\"nameBank\")}\n                                    </label>\n                                    {/**/}\n                                </div>\n                                <div className=\"van-cell__value van-field__value\">\n                                    <div className=\"van-field__body\">\n                                        <input\n                                            type=\"text\"\n                                            id=\"van-field-28-input\"\n                                            className=\"van-field__control\"\n                                            onClick={() => setOpenSelectbank(true)}\n                                            placeholder={t(\"Click to select bank\")}\n                                            aria-labelledby=\"van-field-28-label\"\n                                            data-allow-mismatch=\"attribute\"\n                                            {...register(\"nameBank\", {\n                                                required: t(\"field_required\"),\n\n                                            })}\n                                        />\n\n                                    </div>\n\n                                </div>\n                                <i className=\"van-badge__wrapper van-icon van-icon-arrow van-cell__right-icon\">\n\n                                </i>\n\n                            </div>\n                            {errors.nameBank && <p className='pl-2 text-red-600 text-[12px]'>{errors.nameBank.message}</p>}\n                            <div data-v-1ad66f02=\"\" className=\"van-cell van-field\">\n\n                                <div className=\"van-cell__title van-field__label\">\n                                    <label\n                                        id=\"van-field-29-label\"\n                                        htmlFor=\"van-field-29-input\"\n                                        data-allow-mismatch=\"attribute\"\n                                    >\n                                        {t(\"numberBank\")}\n                                    </label>\n                                    {/**/}\n                                </div>\n                                <div className=\"van-cell__value van-field__value\">\n                                    <div className=\"van-field__body\">\n                                        <input\n                                            type=\"text\"\n                                            id=\"van-field-29-input\"\n                                            className=\"van-field__control\"\n                                            placeholder={t(\"Enter Bank Account Number\")}\n                                            aria-labelledby=\"van-field-29-label\"\n                                            data-allow-mismatch=\"attribute\"\n                                            {...register(\"numberBank\", {\n                                                required: t(\"field_required\"),\n\n                                            })}\n                                        />\n\n                                    </div>\n\n                                </div>\n                            </div>\n                            {errors.numberBank && <p className='pl-2 text-red-600 text-[12px]'>{errors.numberBank.message}</p>}\n\n                            <div data-v-1ad66f02=\"\" className=\"submit-btn\">\n                                <button\n                                    data-v-1ad66f02=\"\"\n                                    type=\"submit\"\n                                    className=\"w-full text-[#fff] rounded-md van-button van-button--primary van-button--normal van-button--block van-button--round\"\n                                >\n                                    <div className=\"van-button__content\">\n                                        {/**/}\n                                        <span className=\"van-button__text\">\n                                            {t(\"Add Account\")}\n                                        </span>\n                                        {/**/}\n                                    </div>\n                                </button>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n\n\n            </Drawer>\n        </>\n    )\n\n}\n","/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/InviteFriend.tsx",["287"],[],"import { Drawer, message } from 'antd'\nimport React from 'react'\nimport { useAuthApp } from 'store/useAuthApp'\nimport QRCode from \"react-qr-code\";\nimport { getUrl } from 'lib/helpers';\nimport { useCopyToClipboard } from '@uidotdev/usehooks';\nimport { useGlobalAppStore } from 'store/useGlobalApp';\nimport { useTranslation } from 'react-i18next';\n\ninterface Props {\n    open: boolean,\n    onClose: () => void\n}\n\nconst InviteFriend = ({ onClose, open }: Props) => {\n    const { user } = useAuthApp()\n    const {configApp} = useGlobalAppStore()\n    const [_, copyToClipboard] = useCopyToClipboard();\n    const {t} = useTranslation()\n    return (\n        <>\n            <Drawer\n                title={\n                    <div className='text-center'>\n                        {t(\"Mời bạn bè\")}\n                    </div>\n                }\n                placement={'right'}\n                closable={true}\n                closeIcon={\n                    <div>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5 hover:text-[#000]\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15.75 19.5 8.25 12l7.5-7.5\" />\n                        </svg>\n\n\n                    </div>\n                }\n                onClose={() => onClose()}\n                width=\"100VW\"\n                open={open}\n\n            >\n                <div data-v-7e679115=\"\" className=\"page-content\">\n                    <div data-v-7e679115=\"\" className=\"invite-card\">\n                        <div data-v-7e679115=\"\" className=\"card-content\">\n                            <div data-v-7e679115=\"\" className=\"card-title\">\n                                {t(\"Invite friends to join\")}\n                            </div>\n                            <div data-v-7e679115=\"\" className=\"card-subtitle\">\n                                {t(\"Share to get more rewards\")}\n                            </div>\n                            <div data-v-7e679115=\"\" className=\"reward-info\">\n                                <div data-v-7e679115=\"\" className=\"reward-item\">\n                                    <span data-v-7e679115=\"\" className=\"value\">\n                                        {configApp?.vipReward?.reward_a}%\n                                    </span>\n                                    <span data-v-7e679115=\"\" className=\"label\">\n                                        Level A\n                                    </span>\n                                </div>\n                                <div data-v-7e679115=\"\" className=\"divider\" />\n                                <div data-v-7e679115=\"\" className=\"reward-item\">\n                                    <span data-v-7e679115=\"\" className=\"value\">\n                                        {configApp?.vipReward?.reward_b}%\n                                    </span>\n                                    <span data-v-7e679115=\"\" className=\"label\">\n                                        Level B\n                                    </span>\n                                </div>\n                                <div data-v-7e679115=\"\" className=\"divider\" />\n                                <div data-v-7e679115=\"\" className=\"reward-item\">\n                                    <span data-v-7e679115=\"\" className=\"value\">\n                                        {configApp?.vipReward?.reward_c}%\n                                    </span>\n                                    <span data-v-7e679115=\"\" className=\"label\">\n                                        Level C\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div data-v-7e679115=\"\" className=\"card-bg\" />\n                    </div>\n                    <div data-v-7e679115=\"\" className=\"qrcode-section\">\n                        <div data-v-7e679115=\"\" className=\"qrcode-wrapper\">\n                            <div data-v-7e679115=\"\" className=\"qrcode-border flex justify-center items-center\">\n                                <div\n                                    data-v-7e679115=\"\"\n                                    className=\"van-image \"\n\n                                    style={{ width: 190, height: 190 }}\n                                >\n                                    <QRCode\n                                        size={256}\n                                        style={{ height: \"auto\", maxWidth: \"100%\", width: \"100%\" }}\n                                        value={getUrl(`register?r=${user?.refCode}`)}\n                                        viewBox={`0 0 256 256`}\n                                    />\n                                </div>\n                                <div data-v-7e679115=\"\" className=\"corner-decoration top-left\" />\n                                <div data-v-7e679115=\"\" className=\"corner-decoration top-right\" />\n                                <div data-v-7e679115=\"\" className=\"corner-decoration bottom-left\" />\n                                <div data-v-7e679115=\"\" className=\"corner-decoration bottom-right\" />\n                            </div>\n                        </div>\n                        <p data-v-7e679115=\"\" className=\"qrcode-tip\">\n                            {t(\"Scan QR code to join\")}\n                        </p>\n                    </div>\n                    <div data-v-7e679115=\"\" className=\"invite-info\">\n                        <div data-v-7e679115=\"\" className=\"info-item\">\n                            <div data-v-7e679115=\"\" className=\"item-content\">\n                                <span data-v-7e679115=\"\" className=\"label\">\n                                    {t(\"Invite code\")}\n                                </span>\n                                <span data-v-7e679115=\"\" className=\"value\">\n                                    {user?.refCode}\n                                </span>\n                            </div>\n                            <svg\n                                onClick={() => {\n                                    copyToClipboard(`${user?.refCode}`)\n                                    message.success(\"Copied\")\n                                }}\n                                data-v-7e679115=\"\"\n                                className=\"inline-block copy-icon\"\n                                viewBox=\"0 0 24 24\"\n                                width=\"1.2em\"\n                                height=\"1.2em\"\n                            >\n                                <path\n                                    fill=\"currentColor\"\n                                    d=\"M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12z\"\n                                />\n                            </svg>\n                        </div>\n                        <div data-v-7e679115=\"\" className=\"info-item\">\n                            <div data-v-7e679115=\"\" className=\"item-content\">\n                                <span data-v-7e679115=\"\" className=\"label\">\n                                    {t(\"Invite link\")}\n                                </span>\n                                <span data-v-7e679115=\"\" className=\"value\">\n                                    {getUrl(`register?r=${user?.refCode}`)}\n                                </span>\n                            </div>\n                            <svg\n                                onClick={() => {\n                                    copyToClipboard(getUrl(`register?r=${user?.refCode}`))\n                                    message.success(\"Copied\")\n                                }}\n                                data-v-7e679115=\"\"\n                                className=\"inline-block copy-icon\"\n                                viewBox=\"0 0 24 24\"\n                                width=\"1.2em\"\n                                height=\"1.2em\"\n                            >\n                                <path\n                                    fill=\"currentColor\"\n                                    d=\"M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12z\"\n                                />\n                            </svg>\n                        </div>\n                    </div>\n                </div>\n\n            </Drawer>\n        </>\n    )\n}\n\nexport default InviteFriend","/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/RecordUserHistory.tsx",["288","289"],[],"import { Drawer, Tabs, Tag } from 'antd'\nimport requestService from 'api/request'\nimport clsx from 'clsx'\nimport { formatNumber } from 'lib/helpers'\nimport React, { useEffect, useState } from 'react'\nimport { useTranslation } from 'react-i18next'\ninterface Props {\n    setOpen: (val: boolean) => void,\n    open: boolean\n}\nconst RecordUserHistoires = ({ open, setOpen }: Props) => {\n    const [data, setData] = useState([])\n    const [transactionType, setTransactionType] = useState('deposit')\n    const { t } = useTranslation()\n\n    const getHistory = async () => {\n        try {\n            const res = await requestService.get('/profile/history-user', {\n                params: {\n                    transaction_type: transactionType\n                }\n            })\n            if (res && res.data) {\n                setData(res?.data?.data)\n            }\n        } catch (error) {\n            console.log('====================================');\n            console.log(error);\n            console.log('====================================');\n        }\n    }\n\n    useEffect(() => {\n        getHistory()\n    }, [transactionType])\n    return <Drawer\n        title={\n            <div className='text-center'>\n                {t(\"Lịch sử giao dịch\")}\n            </div>\n        }\n        placement={'right'}\n        closable={true}\n        closeIcon={\n            <div>\n                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5 hover:text-[#000]\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15.75 19.5 8.25 12l7.5-7.5\" />\n                </svg>\n\n\n            </div>\n        }\n        onClose={() => setOpen(false)}\n        width=\"100VW\"\n        open={open}\n\n    >\n        <Tabs\n            defaultActiveKey=\"deposit\"\n\n            className='tab-record'\n            size='large'\n            centered\n            onChange={(key) => {\n                setData([])\n                setTransactionType(key)\n\n            }}\n            items={[\n                {\n                    key: \"deposit\",\n                    label: t(\"home.deposit\"),\n                },\n                {\n                    key: \"withdraw\",\n                    label: t(\"home.withdraw\"),\n\n                },\n                // {\n                //     key: \"reward_vip\",\n                //     label: t(\"reward_vip\"),\n                // },\n            ]}\n\n        />\n\n        <div data-v-08b1e8b3=\"\" className=\"records-list\">\n\n            {\n                data?.length > 0 &&\n                data?.map((i: any) => (\n                    <div data-v-08b1e8b3 className='record-item flex items-center relative' key={i?._id}>\n                        <div className='absolute left-0 top-[-5px]'>\n                            <Tag className='uppercase rounded-2xl' color={\n                                i?.transaction_status === 'finish' ? \"green-inverse\" :\n                                    i?.transaction_status === 'pending' ? \"orange-inverse\" : 'red-inverse'\n                            }>\n                                {i?.transaction_status}\n                            </Tag>\n                        </div>\n                        <div data-v-08b1e8b3 className='record-left'>\n                            <div data-v-08b1e8b3 className='record-time'>\n                                {new Date(i?.createdAt)?.toLocaleString()}\n                            </div>\n                            <div data-v-08b1e8b3 className='record-balance'>\n                                <div data-v-08b1e8b3 className='label'>\n                                    {t(\"Số dư\")} :\n                                </div>\n                                <div data-v-08b1e8b3 className='value'>\n                                    {formatNumber(Number(i?.currentBalanceUser)?.toFixed(2)?.toLocaleString())}\n                                </div>\n                                <div data-v-08b1e8b3 className='currency'>\n                                    $\n                                </div>\n                            </div>\n                        </div>\n                        <div data-v-08b1e8b3 className='record-right'>\n                            <div data-v-08b1e8b3 className={clsx('record-amount  flex items-center', {\n                                \"income\": i?.transaction_type === 'reward_ticket'\n                            })}>\n                                <div data-v-08b1e8b3 className='amount'>\n                                    {i?.value > 0 ? \"+\" : \"\"}  {formatNumber(Number(i?.value)?.toFixed(2)?.toLocaleString())}\n                                </div>\n                                <div data-v-08b1e8b3 className='currency'>\n                                    $\n                                </div>\n                            </div>\n                            <div data-v-08b1e8b3 className='record-reason'>\n                                {\n                                    i?.transaction_type === 'deposit' && t(\"home.deposit\")\n                                }\n                                {\n                                    i?.transaction_type === 'withdraw' && t(\"home.withdraw\")\n                                }\n                            </div>\n                            {\n                                i?.reason && <div className='text-red-500'>\n                                    {i?.reason}\n                                </div>\n                            }\n\n                        </div>\n\n                    </div>\n                ))\n            }\n\n            {\n                data?.length == 0 &&\n                <div data-v-08b1e8b3=\"\" role=\"feed\" className=\"van-list\" aria-busy=\"false\">\n\n                    <div className=\"van-list__finished-text text-center\">\n                        {t(\"Không có dữ liệu\")}\n                    </div>\n\n                    <div className=\"van-list__placeholder\" />\n                </div>\n            }\n\n        </div>\n\n    </Drawer>\n}\n\nexport default RecordUserHistoires","/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/SecurityCenter.tsx",["290","291"],[],"import { Drawer, message } from 'antd'\nimport requestService from 'api/request'\nimport React, { useState } from 'react'\nimport { SubmitHandler, useForm } from 'react-hook-form'\nimport { useTranslation } from 'react-i18next'\n\ninterface Props {\n    setOpen: (val: boolean) => void,\n    open: boolean,\n\n}\n\nconst SecurityCenter = ({ open, setOpen }: Props) => {\n    const { t } = useTranslation()\n    const [openChange, setOpenChange] = useState<string | boolean>(false)\n    const [shopPasss, setShowPass] = useState(false)\n    const { register, handleSubmit, watch, control, reset, setValue, formState: { errors } } = useForm<{\n        oldPassword: string,\n        newPassword: string,\n        confirmPassword: string\n    }>({\n    });\n\n    const newPassword = watch(\"newPassword\");\n\n    const onChangePassWord: SubmitHandler<{\n        oldPassword: string,\n        newPassword: string,\n        confirmPassword: string\n    }> = async (data) => {\n        try {\n            const res = await requestService.post('/profile/update-password', {\n                data: {\n                    oldPassword: data.oldPassword,\n                    newPassword: data.newPassword,\n                    type: openChange\n                }\n            })\n            if (res && res.data) {\n                message.success(\"Updated\")\n                reset()\n                setOpenChange(false)\n            }\n        } catch (error: any) {\n            setOpenChange(false)\n            message.warning(error?.response?.data?.message)\n        }\n\n    }\n    return (\n        <>\n            <Drawer\n                open={!!openChange}\n                onClose={() => setOpenChange(false)}\n                placement='bottom'\n                height={\"60vh\"}\n                width={\"100vw\"}\n                zIndex={9999}\n                className='security'\n                closeIcon={false}\n                title={\n                    <div className='flex justify-between'>\n                        <div className='cursor-pointer ' onClick={() => {\n                            setOpenChange(false)\n                        }}>\n                            {\n                                openChange === 'pass_login' && t(\"modify login password\")\n                            }\n                            {\n                                openChange === 'pass_payment' && t(\"modify payment password\")\n                            }\n                        </div>\n                        <div className='cursor-pointer' onClick={() => {\n                            setOpenChange(false)\n                            reset()\n\n                        }}>\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-6\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\" />\n                            </svg>\n\n                        </div>\n                    </div>\n                }\n            >\n\n                <div data-v-631327fb=\"\" className=\"password-popup\">\n                    <div data-v-631327fb=\"\" className=\"popup-content\">\n                        <form data-v-631327fb=\"\" className=\"van-form\" onSubmit={handleSubmit(onChangePassWord)}>\n                            <div data-v-631327fb=\"\" className=\"van-cell-group van-cell-group--inset\">\n                                <div data-v-631327fb=\"\" className=\"van-cell van-field\">\n                                    {/**/}\n                                    <div className=\"van-cell__title van-field__label\">\n                                        <label\n                                            id=\"van-field-1-label\"\n                                            htmlFor=\"van-field-1-input\"\n                                            data-allow-mismatch=\"attribute\"\n                                        >\n                                            {t(\"Old password\")}\n                                        </label>\n                                        {/**/}\n                                    </div>\n                                    <div className=\"van-cell__value van-field__value\">\n                                        <div className=\"van-field__body\">\n                                            <input\n                                                type={shopPasss ? \"text\" : \"password\"}\n                                                id=\"van-field-1-input\"\n                                                className=\"van-field__control\"\n                                                placeholder={t(\"please enter the original password\")}\n                                                aria-labelledby=\"van-field-1-label\"\n                                                data-allow-mismatch=\"attribute\"\n                                                {...register(\"oldPassword\", {\n                                                    required: t(\"Please enter the old password\"),\n                                                })}\n                                            />\n                                            {/**/}\n                                            <div className=\"van-field__right-icon\" onClick={() => setShowPass(!shopPasss)}>\n                                                {\n                                                    shopPasss ?\n                                                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5\">\n                                                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z\" />\n                                                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z\" />\n                                                        </svg>\n                                                        :\n\n                                                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5\">\n                                                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88\" />\n                                                        </svg>\n                                                }\n\n\n                                            </div>\n                                            {/**/}\n                                        </div>\n                                        {/**/}\n                                        {/**/}\n                                    </div>\n                                    {/**/}\n                                    {/**/}\n                                </div>\n                                {errors.oldPassword && <p className='pl-2 text-red-600 text-[12px]'>{errors.oldPassword.message}</p>}\n                                <div data-v-631327fb=\"\" className=\"van-cell van-field\">\n                                    {/**/}\n                                    <div className=\"van-cell__title van-field__label\">\n                                        <label\n                                            id=\"van-field-2-label\"\n                                            htmlFor=\"van-field-2-input\"\n                                            data-allow-mismatch=\"attribute\"\n                                        >\n                                            {t(\"New Password\")}\n                                        </label>\n                                        {/**/}\n                                    </div>\n                                    <div className=\"van-cell__value van-field__value\">\n                                        <div className=\"van-field__body\">\n                                            <input\n                                                type={shopPasss ? \"text\" : \"password\"}\n                                                id=\"van-field-2-input\"\n                                                className=\"van-field__control\"\n                                                placeholder={t(\"please enter the new password\")}\n                                                aria-labelledby=\"van-field-2-label\"\n                                                data-allow-mismatch=\"attribute\"\n                                                {...register(\"newPassword\", {\n                                                    required: t(\"Please enter the newPassword\"),\n                                                    validate: value => {\n                                                        if (openChange === \"pass_payment\" && value.length !== 6) {\n                                                            return t(\"Password must be at exactly 6 characters\");\n                                                        }\n                                                        if (openChange !== \"pass_payment\" && value.length > 10) {\n                                                            return t(\"Password must be at most 10 characters\");\n                                                        }\n                                                        return true;\n                                                    }\n                                                })}\n\n                                            />\n                                            {/**/}\n                                            {/**/}\n                                            {/**/}\n                                        </div>\n                                        {/**/}\n                                        {/**/}\n                                    </div>\n                                    {/**/}\n                                    {/**/}\n                                </div>\n                                {errors.newPassword && <p className='pl-2 text-red-600 text-[12px]'>{errors.newPassword.message}</p>}\n\n                                <div data-v-631327fb=\"\" className=\"van-cell van-field\">\n                                    {/**/}\n                                    <div className=\"van-cell__title van-field__label\">\n                                        <label\n                                            id=\"van-field-3-label\"\n                                            htmlFor=\"van-field-3-input\"\n                                            data-allow-mismatch=\"attribute\"\n                                        >\n                                            {t(\"confirm password\")}\n                                        </label>\n                                        {/**/}\n                                    </div>\n                                    <div className=\"van-cell__value van-field__value\">\n                                        <div className=\"van-field__body\">\n                                            <input\n                                                type={shopPasss ? \"text\" : \"password\"}\n                                                id=\"van-field-3-input\"\n                                                className=\"van-field__control\"\n                                                placeholder={t(\"please enter the new password again\")}\n                                                aria-labelledby=\"van-field-3-label\"\n                                                data-allow-mismatch=\"attribute\"\n                                                {...register(\"confirmPassword\", {\n                                                    required: t(\"Please enter the confirmPassword\"),\n                                                    validate: value =>\n                                                        value === newPassword || t(\"Passwords do not match\"),\n                                                })}\n                                            />\n                                            {/**/}\n                                            {/**/}\n                                            {/**/}\n                                        </div>\n                                        {/**/}\n                                        {/**/}\n                                    </div>\n                                    {/**/}\n                                    {/**/}\n                                </div>\n                                {errors.confirmPassword && <p className='pl-2 text-red-600 text-[12px]'>{errors.confirmPassword.message}</p>}\n\n                            </div>\n                            <div data-v-631327fb=\"\" className=\"submit-section\">\n                                <button\n                                    data-v-631327fb=\"\"\n                                    type=\"submit\"\n                                    className=\"w-full text-[#fff] van-button van-button--primary van-button--normal van-button--block\"\n                                >\n                                    <div className=\"van-button__content\">\n                                        {/**/}\n                                        <span className=\"van-button__text\">Save</span>\n                                        {/**/}\n                                    </div>\n                                </button>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n\n\n\n            </Drawer >\n            <Drawer\n                title={\n                    <div className='text-center'>\n                        {t(\"Security Center\")}\n                    </div>\n                }\n                placement={'right'}\n                style={{\n                    background: \"#fff\"\n                }}\n                closable={true}\n                closeIcon={\n                    <div>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5 hover:text-[#000]\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15.75 19.5 8.25 12l7.5-7.5\" />\n                        </svg>\n\n\n                    </div>\n                }\n                onClose={() => setOpen(false)}\n                width=\"100VW\"\n                open={open}\n\n            >\n\n                <div data-v-631327fb=\"\" className=\"page-content\">\n                    <div data-v-631327fb=\"\" className=\"security-list\">\n                        <div data-v-631327fb=\"\" className=\"security-item\" onClick={() => setOpenChange(\"pass_login\")}>\n                            <div data-v-631327fb=\"\" className=\"item-left\">\n                                <svg\n                                    data-v-631327fb=\"\"\n                                    className=\"inline-block security-icon\"\n                                    viewBox=\"0 0 24 24\"\n                                    width=\"1.2em\"\n                                    height=\"1.2em\"\n                                    style={{ color: \"rgb(25, 137, 250)\" }}\n                                >\n                                    <path\n                                        fill=\"currentColor\"\n                                        d=\"M12 17a2 2 0 0 0 2-2a2 2 0 0 0-2-2a2 2 0 0 0-2 2a2 2 0 0 0 2 2m6-9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2h1V6a5 5 0 0 1 5-5a5 5 0 0 1 5 5v2zm-6-5a3 3 0 0 0-3 3v2h6V6a3 3 0 0 0-3-3\"\n                                    />\n                                </svg>\n                                <div data-v-631327fb=\"\" className=\"item-info\">\n                                    <span data-v-631327fb=\"\" className=\"title\">\n                                        {t(\"login password\")}\n                                    </span>\n                                    <span data-v-631327fb=\"\" className=\"desc\">\n                                        {t(\"for account login\")}\n                                    </span>\n                                </div>\n                            </div>\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"m8.25 4.5 7.5 7.5-7.5 7.5\" />\n                            </svg>\n\n                        </div>\n                        <div data-v-631327fb=\"\" className=\"security-item\" onClick={() => setOpenChange(\"pass_payment\")}>\n                            <div data-v-631327fb=\"\" className=\"item-left\">\n                                <svg\n                                    data-v-631327fb=\"\"\n                                    className=\"inline-block security-icon\"\n                                    viewBox=\"0 0 24 24\"\n                                    width=\"1.2em\"\n                                    height=\"1.2em\"\n                                    style={{ color: \"rgb(7, 193, 96)\" }}\n                                >\n                                    <path\n                                        fill=\"currentColor\"\n                                        d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12c5.16-1.26 9-6.45 9-12V5zm0 6c1.4 0 2.8 1.1 2.8 2.5V11c.6 0 1.2.6 1.2 1.3v3.5c0 .6-.6 1.2-1.3 1.2H9.2c-.6 0-1.2-.6-1.2-1.3v-3.5c0-.6.6-1.2 1.2-1.2V9.5C9.2 8.1 10.6 7 12 7m0 1.2c-.8 0-1.5.5-1.5 1.3V11h3V9.5c0-.8-.7-1.3-1.5-1.3\"\n                                    />\n                                </svg>\n                                <div data-v-631327fb=\"\" className=\"item-info\">\n                                    <span data-v-631327fb=\"\" className=\"title\">\n                                        {t(\"Payment password\")}\n                                    </span>\n                                    <span data-v-631327fb=\"\" className=\"desc\">\n                                        {t(\"Used for fund-related operations\")}\n                                    </span>\n                                </div>\n                            </div>\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"m8.25 4.5 7.5 7.5-7.5 7.5\" />\n                            </svg>\n\n                        </div>\n                    </div>\n                </div>\n\n            </Drawer>\n        </>\n\n    )\n}\n\nexport default SecurityCenter","/Users/nguyenthanhloc/Documents/investment-fe/src/components/elements/Empty.tsx",[],[],"/Users/nguyenthanhloc/Documents/investment-fe/src/pages/auth/Login.tsx",["292","293","294","295"],[],"import { message } from 'antd';\nimport requestService from 'api/request';\nimport logo from 'assets/images/logo.png'\nimport { SubmitHandler, useForm } from 'react-hook-form';\nimport { useTranslation } from 'react-i18next';\nimport { useNavigate } from 'react-router-dom';\nimport { useAuthApp } from 'store/useAuthApp';\nimport { useGlobalAppStore } from 'store/useGlobalApp';\n\ninterface IFormInput {\n    phone: string;\n    password: string;\n}\n\nconst Login = () => {\n    const { onSetUser } = useAuthApp()\n    const { loading, handleLoading } = useGlobalAppStore()\n    const {t} = useTranslation()\n    const navigate = useNavigate()\n    const { register, handleSubmit, watch, control, setValue, formState: { errors } } = useForm<IFormInput>({\n    });\n\n    const onSubmit: SubmitHandler<IFormInput> = async (data) => {\n\n        handleLoading(true)\n        try {\n            const res = await requestService.post('/auth/login', {\n                data: {\n                    ...data\n                }\n            })\n            if (res && res.data) {\n                \n                localStorage.setItem(\n                    \"accessToken\",\n                    res?.data?.data?.tokens?.accessToken\n                );\n                localStorage.setItem(\n                    \"refreshToken\",\n                    res?.data?.data?.tokens?.refreshToken\n                );\n                onSetUser(res?.data?.data?.user)\n              \n                // message.success(res?.data?.message)\n                handleLoading(false)\n                setTimeout(() => {\n                    navigate('/')\n                }, 500)\n                \n            }\n        } catch (error: any) {\n            console.log('====================================');\n            console.log(error);\n            console.log('====================================');\n            message.error(error?.response?.data?.message)\n            handleLoading(false)\n        }\n     \n    };\n\n\n    return (\n        <div data-v-544b5ac9=\"\" data-v-daf86cc3=\"\" className=\"login-content\">\n            <div data-v-544b5ac9=\"\" className=\"login-image flex justify-center\">\n                <img\n                    data-v-544b5ac9=\"\"\n                    src={logo}\n                    alt=\"Login\"\n                    // className='rounded-full'\n                />\n            </div>\n            <form data-v-544b5ac9=\"\" className=\"login-form\" onSubmit={handleSubmit(onSubmit)}>\n                <div data-v-544b5ac9=\"\" className=\"form-item\">\n                    <div data-v-544b5ac9=\"\" className=\"van-cell van-field\">\n                        <div className=\"van-field__left-icon\">\n                            <div data-v-544b5ac9=\"\" className=\"country-code\">\n                                +84\n                            </div>\n                        </div>\n                        {/**/}\n                        <div className=\"van-cell__value van-field__value\">\n                            <div className=\"van-field__body\">\n                                <input\n                                    type=\"tel\"\n                                    inputMode=\"numeric\"\n                                    id=\"van-field-5-input\"\n                                    {...register(\"phone\", {\n                                        required: t(\"auth.phone_required\"),\n                                        pattern: {\n                                            value: /^(0[1-9]\\d{8})$|^(0?\\d{9})$|^(?:\\d{3}[-\\s]?\\d{3}[-\\s]?\\d{4})$|^(?:\\(\\d{3}\\)[-\\s]?\\d{3}[-\\s]?\\d{4})$/\n                                            ,\n                                            message: t(\"auth.invalid_phone_number_format\")\n                                        }\n\n                                    })}\n                                    className=\"van-field__control\"\n                                    placeholder={t(\"auth.phone\")}\n                                    autoComplete=\"off\"\n                                    data-allow-mismatch=\"attribute\"\n                                />\n                                {/**/}\n                                {/**/}\n                                {/**/}\n                            </div>\n                            {/**/}\n                            {/**/}\n                        </div>\n                        {/**/}\n                        {/**/}\n                    </div>\n                    {errors.phone && <p className='pl-2 text-red-600 text-[12px]'>{errors.phone.message}</p>}\n                </div>\n                <div data-v-544b5ac9=\"\" className=\"form-item\">\n                    <div data-v-544b5ac9=\"\" className=\"van-cell van-field\">\n                        <div className=\"van-field__left-icon\">\n                            <i className=\"van-badge__wrapper van-icon van-icon-shield-o\">\n                                {/**/}\n                                {/**/}\n                                {/**/}\n                            </i>\n                        </div>\n                        {/**/}\n                        <div className=\"van-cell__value van-field__value\">\n                            <div className=\"van-field__body\">\n                                <input\n                                    type=\"password\"\n                                    id=\"van-field-6-input\"\n                                    {...register(\"password\", {\n                                        required: t(\"auth.password_required\"),\n\n                                    })}\n                                    className=\"van-field__control\"\n                                    placeholder={t(\"auth.password\")}\n                                    autoComplete=\"current-password\"\n                                    data-allow-mismatch=\"attribute\"\n                                />\n                                {/**/}\n                                <div className=\"van-field__right-icon\">\n                                    <i className=\"van-badge__wrapper van-icon van-icon-closed-eye\">\n                                        {/**/}\n                                        {/**/}\n                                        {/**/}\n                                    </i>\n                                </div>\n                                {/**/}\n                            </div>\n                            {/**/}\n                            {/**/}\n                        </div>\n                        {/**/}\n                        {/**/}\n                    </div>\n                    {errors.password && <p className='pl-2 text-red-600 text-[12px]'>{errors.password.message}</p>}\n                </div>\n\n                {/**/}\n                <div data-v-544b5ac9=\"\" className=\"submit-btn\">\n                    <button\n                        data-v-544b5ac9=\"\"\n                        type=\"submit\"\n                        className=\"w-full rounded-lg text-[#fff] van-button van-button--primary van-button--normal van-button--block van-button--round van-button--disabled\"\n\n                    >\n                        <div className=\"van-button__content\">\n                            {/**/}\n                            <span className=\"van-button__text\">{t(\"auth.login\")}</span>\n                            {/**/}\n                        </div>\n                    </button>\n                </div>\n            </form>\n        </div>\n    )\n}\n\nexport default Login","/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/QuickAction.tsx",[],[],"/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/RecordOrders.tsx",["296"],[],"import { Drawer } from 'antd'\nimport requestService from 'api/request'\nimport clsx from 'clsx'\nimport { formatNumber } from 'lib/helpers'\nimport React, { useEffect, useState } from 'react'\nimport { useTranslation } from 'react-i18next'\ninterface Props {\n    setOpen: (val: boolean) => void,\n    open: boolean\n}\nconst RecordOrders = ({ open, setOpen }: Props) => {\n    const [data, setData] = useState([])\n    const { t } = useTranslation()\n    const getRewards = async () => {\n        try {\n            const res = await requestService.get('/tickets/order-reward')\n            if (res && res.data) {\n                setData(res?.data?.data)\n            }\n        } catch (error) {\n            console.log('====================================');\n            console.log(error);\n            console.log('====================================');\n        }\n    }\n\n    useEffect(() => {\n        getRewards()\n    }, [])\n\n    return <Drawer\n        title={\n            <div className='text-center'>\n                {t(\"Lịch sử giao dịch\")}\n            </div>\n        }\n        placement={'right'}\n        closable={true}\n        closeIcon={\n            <div>\n                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5 hover:text-[#000]\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15.75 19.5 8.25 12l7.5-7.5\" />\n                </svg>\n\n\n            </div>\n        }\n        onClose={() => setOpen(false)}\n        width=\"100VW\"\n        open={open}\n\n    >\n        <div data-v-08b1e8b3=\"\" className=\"records-list\">\n            {\n                data?.length > 0 &&\n                data?.map((i: any) => (\n                    <div data-v-08b1e8b3 className='record-item flex items-center' key={i?._id}>\n                        <div data-v-08b1e8b3 className='record-left'>\n                            <div data-v-08b1e8b3 className='record-time'>\n                                {new Date(i?.createdAt)?.toLocaleString()}\n                            </div>\n                            <div data-v-08b1e8b3 className='record-balance'>\n                                <div data-v-08b1e8b3 className='label'>\n                                    {t(\"Số dư\")} :\n                                </div>\n                                <div data-v-08b1e8b3 className='value'>\n                                    {formatNumber(i?.currentBalanceUser?.toLocaleString())}\n                                </div>\n                                <div data-v-08b1e8b3 className='currency'>\n                                    $\n                                </div>\n                            </div>\n                        </div>\n                        <div data-v-08b1e8b3 className='record-right'>\n                            <div data-v-08b1e8b3 className={clsx('record-amount  flex items-center', {\n                                \"income\": i?.transaction_type === 'reward_ticket'\n                            })}>\n                                <div data-v-08b1e8b3 className='amount'>\n                                    {i?.value > 0 ? \"+\" : \"\"} {i?.value}\n                                </div>\n                                <div data-v-08b1e8b3 className='currency'>\n                                    $\n                                </div>\n                            </div>\n                            <div data-v-08b1e8b3 className='record-reason'>\n                                {\n                                    i?.transaction_type === 'reward_ticket' && t(\"Cộng tiền phân phối\")\n                                }\n                                {\n                                    i?.transaction_type === 'buy_ticket' && t(\"Mua ticket\")\n                                }\n                            </div>\n                        </div>\n                    </div>\n                ))\n            }\n            {\n                data?.length == 0 &&\n                <div data-v-08b1e8b3=\"\" role=\"feed\" className=\"van-list\" aria-busy=\"false\">\n\n                    <div className=\"van-list__finished-text text-center\">\n                            {t(\"Không có dữ liệu\")}\n                    </div>\n\n                    <div className=\"van-list__placeholder\" />\n                </div>\n            }\n\n        </div>\n\n    </Drawer>\n}\n\nexport default RecordOrders","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/auth/Register.tsx",["297","298","299"],[],"import { message } from 'antd';\nimport requestService from 'api/request';\nimport clsx from 'clsx'\nimport { getJSONFromUrl } from 'lib/helpers';\nimport { useEffect, useState } from 'react';\nimport { SubmitHandler, useForm } from 'react-hook-form';\nimport { useTranslation } from 'react-i18next';\nimport { useNavigate } from 'react-router-dom';\nimport { useAuthApp } from 'store/useAuthApp';\nimport { useGlobalAppStore } from 'store/useGlobalApp';\n\ninterface IFormInput {\n    phone: string;\n    password: string;\n    payment_password: string;\n    inviteCode: string,\n    isCheckPolicy: boolean\n}\n\n\nconst Register = () => {\n    const { r } = getJSONFromUrl()\n    const { loading, handleLoading } = useGlobalAppStore()\n    const [shopPasss, setShowPass] = useState(false)\n    const { onSetUser } = useAuthApp()\n    const { t } = useTranslation()\n    const navigate = useNavigate()\n    const { register, handleSubmit, watch, control, setValue, formState: { errors } } = useForm<IFormInput>({\n        defaultValues: {\n            isCheckPolicy: false\n        }\n    });\n    const isCheckPolicy = watch('isCheckPolicy')\n    const payment_password = watch('payment_password')\n\n    useEffect(() => {\n        setValue('inviteCode', r)\n    }, [r])\n    const onSubmit: SubmitHandler<IFormInput> = async (data) => {\n        if (!isCheckPolicy) return message.error(t(\"Bạn chưa đồng ý với điều khoản dịch vụ\"))\n        handleLoading(true)\n        try {\n            const res = await requestService.post('/auth/register', {\n                data: {\n                    ...data\n                }\n            })\n            if (res && res.data) {\n\n                localStorage.setItem(\n                    \"accessToken\",\n                    res?.data?.data?.tokens?.accessToken\n                );\n                localStorage.setItem(\n                    \"refreshToken\",\n                    res?.data?.data?.tokens?.refreshToken\n                );\n                onSetUser(res?.data?.data?.user)\n                // message.success(res?.data?.message)\n                setTimeout(() => {\n                    handleLoading(false)\n                    navigate('/')\n                }, 500)\n\n            }\n        } catch (error: any) {\n            message.error(error?.response?.data?.message)\n            handleLoading(false)\n        }\n\n    };\n\n\n    return (\n        <div data-v-fed939fe=\"\" data-v-daf86cc3=\"\" className=\"register-content\">\n            <div data-v-fed939fe=\"\" className=\"title\">\n                {t(\"auth.title_regis\")}\n            </div>\n            <form data-v-fed939fe=\"\" className={clsx(\"register-form\")} onSubmit={handleSubmit(onSubmit)}>\n                <div data-v-fed939fe=\"\" className=\"form-item\">\n                    <div data-v-fed939fe=\"\" className=\"van-cell van-field\">\n                        <div className=\"van-field__left-icon\">\n                            <div data-v-fed939fe=\"\" className=\"country-code\">\n                                +84\n                            </div>\n                        </div>\n                        {/**/}\n                        <div className=\"van-cell__value van-field__value\">\n                            <div className=\"van-field__body\">\n                                <input\n                                    type=\"tel\"\n                                    inputMode=\"numeric\"\n                                    id=\"van-field-52-input\"\n                                    className=\"van-field__control\"\n                                    placeholder={t(\"auth.phone\")}\n                                    autoComplete=\"tel\"\n                                    data-allow-mismatch=\"attribute\"\n                                    {...register(\"phone\", {\n                                        required: t(\"auth.phone_required\"),\n                                        pattern: {\n                                            value: /^(?:\\d{9})$|^(?:\\d{3}[-\\s]?\\d{3}[-\\s]?\\d{3,4})$|^(?:\\(\\d{3}\\)[-\\s]?\\d{3}[-\\s]?\\d{3,4})$/,\n                                            message: t(\"auth.invalid_phone_number_format\")\n                                        }\n\n\n                                    })}\n                                />\n\n                            </div>\n                            {/**/}\n                            {/**/}\n                        </div>\n                        {/**/}\n                        {/**/}\n                    </div>\n                    {errors.phone && <p className='pl-2 text-red-600 text-[12px]'>{errors.phone.message}</p>}\n                </div>\n                {/**/}\n                <div data-v-fed939fe=\"\" className=\"form-item\">\n                    <div data-v-fed939fe=\"\" className=\"van-cell van-field\">\n                        <div className=\"van-field__left-icon\">\n                            <i className=\"van-badge__wrapper van-icon van-icon-shield-o\">\n                                {/**/}\n                                {/**/}\n                                {/**/}\n                            </i>\n                        </div>\n                        {/**/}\n                        <div className=\"van-cell__value van-field__value\">\n                            <div className=\"van-field__body\">\n                                <input\n                                    type={shopPasss ? \"text\" : \"password\"}\n                                    id=\"van-field-53-input\"\n                                    className=\"van-field__control\"\n                                    placeholder={t(\"auth.password\")}\n                                    autoComplete=\"new-password\"\n                                    data-allow-mismatch=\"attribute\"\n                                    {...register(\"password\", {\n                                        required: t(\"auth.password_required\"),\n\n                                    })}\n                                />\n\n                                {/**/}\n                                <div className=\"van-field__right-icon\" onClick={() => setShowPass(!shopPasss)}>\n                                    {\n                                        shopPasss ?\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5\">\n                                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z\" />\n                                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z\" />\n                                            </svg>\n                                            :\n\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5\">\n                                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88\" />\n                                            </svg>\n                                    }\n                                </div>\n                                {/**/}\n                            </div>\n\n                        </div>\n                        {/**/}\n                        {/**/}\n                    </div>\n                    {errors.password && <p className='pl-2 text-red-600 text-[12px]'>{errors.password.message}</p>}\n                </div>\n                <div data-v-fed939fe=\"\" className=\"form-item\">\n                    <div\n                        data-v-fed939fe=\"\"\n                        className=\"van-cell van-field payment-password\"\n                    >\n                        <div className=\"van-field__left-icon\">\n                            <i className=\"van-badge__wrapper van-icon van-icon-lock\">\n\n                            </i>\n                        </div>\n                        {/**/}\n                        <div className=\"van-cell__value van-field__value\">\n                            <div className=\"van-field__body\">\n                                <input\n                                    type={shopPasss ? \"text\" : \"password\"}\n                                    inputMode=\"numeric\"\n                                    id=\"van-field-54-input\"\n                                    className=\"van-field__control\"\n                                    placeholder={t(\"auth.payment_password\")}\n                                    autoComplete=\"new-password\"\n                                    data-allow-mismatch=\"attribute\"\n                                    maxLength={6}\n                                    {...register(\"payment_password\", {\n                                        required: t(\"auth.payment_password_required\"),\n                                        pattern: {\n                                            value: /^[0-9]{6}$/,  // Chỉ chấp nhận 6 ký tự số\n                                            message: t(\"payment_password_maximum_6_characters\") // Lỗi thông báo nếu không khớp\n                                        }\n                                    })}\n                                />\n\n                            </div>\n                            <div className=\"van-field__word-limit\">\n                                <span className=\"van-field__word-num\">{payment_password?.length || 0}</span>/6\n                            </div>\n                            {/**/}\n                        </div>\n                        {/**/}\n                        {/**/}\n                    </div>\n                    {errors.payment_password && <p className='pl-2 text-red-600 text-[12px]'>{errors.payment_password.message}</p>}\n                </div>\n                <div data-v-fed939fe=\"\" className=\"form-item\">\n                    <div data-v-fed939fe=\"\" className=\"van-cell van-field\">\n                        <div className=\"van-field__left-icon\">\n                            <i className=\"van-badge__wrapper van-icon van-icon-friends-o\">\n                                {/**/}\n                                {/**/}\n                                {/**/}\n                            </i>\n                        </div>\n                        {/**/}\n                        <div className=\"van-cell__value van-field__value\">\n                            <div className=\"van-field__body\">\n                                <input\n                                    type=\"text\"\n                                    id=\"van-field-55-input\"\n                                    className=\"van-field__control\"\n                                    placeholder={t(\"auth.inviteCode\")}\n                                    data-allow-mismatch=\"attribute\"\n                                    {...register(\"inviteCode\")}\n                                    disabled={r}\n                                />\n                                {/**/}\n                                {/**/}\n                                {/**/}\n                            </div>\n                            {/**/}\n                            {/**/}\n                        </div>\n                        {/**/}\n                        {/**/}\n                    </div>\n                </div>\n                <div data-v-fed939fe=\"\" className=\"terms\">\n                    <div\n                        data-v-fed939fe=\"\"\n                        role=\"checkbox\"\n                        className=\"van-checkbox flex gap-2 items-start\"\n                        tabIndex={0}\n                        aria-checked=\"false\"\n                    >\n                        <div\n                            className=\" w-[20px] h-[20px] border cursor-pointer rounded-sm mt-1 flex justify-center items-center\"\n                            style={{ fontSize: 16 }}\n                            onClick={() => setValue('isCheckPolicy', !isCheckPolicy)}\n                        >\n                            {\n                                isCheckPolicy &&\n\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth=\"1.5\" stroke=\"currentColor\" className=\"size-4 text-[#439b33]\">\n                                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\" />\n                                </svg>\n                            }\n\n\n                        </div>\n                        <span className=\"van-checkbox__label\">\n                            {t(\"auth.agree\")}{\" \"}\n                            <span data-v-fed939fe=\"\" className=\"terms-link\">\n                                {t(\"auth.policy\")}\n                            </span>\n                        </span>\n                    </div>\n                </div>\n                <div data-v-fed939fe=\"\" className=\"submit-btn\">\n                    <button\n                        data-v-fed939fe=\"\"\n                        type=\"submit\"\n                        className=\"w-full rounded-lg text-[#fff] van-button van-button--primary van-button--normal van-button--block van-button--round van-button--disabled\"\n\n                    >\n                        <div className=\"van-button__content\">\n                            {/**/}\n                            <span className=\"van-button__text\">\n                                {t(\"auth.regis\")}\n                            </span>\n                            {/**/}\n                        </div>\n                    </button>\n                </div>\n            </form>\n        </div>\n    )\n}\n\nexport default Register","/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/VipReward.tsx",[],[],"/Users/nguyenthanhloc/Documents/investment-fe/src/pages/vip/RulesTranlate.tsx",[],[],"/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/home/NutientBanner.tsx",["300","301","302"],[],"import { message } from 'antd';\nimport React, { useState } from 'react'\nimport { useTranslation } from 'react-i18next';\nimport { useAuthApp } from 'store/useAuthApp';\nimport InviteFriend from '../InviteFriend';\n\nconst NutientBanner = () => {\n    const { user } = useAuthApp()\n    const { t, i18n } = useTranslation();\n    const [open, setOpen] = useState(false)\n\n    return (\n        <>\n            {/* nutrient-banner */}\n            <InviteFriend\n                open={open}\n                onClose={() => setOpen(false)}\n            />\n            <div data-v-caee1139=\"\" className=\"nutrient-banner\">\n                <div data-v-caee1139=\"\" className=\"nutrient-content\">\n                    <div data-v-caee1139=\"\" className=\"nutrient-icon\">\n                        <img\n                            data-v-caee1139=\"\"\n                            src=\"https://img.icons8.com/?size=100&id=XsEEVB3VrdJo&format=png&color=000000\"\n                            alt=\"营养液\"\n                        />\n                    </div>\n                    <div data-v-caee1139=\"\" className=\"nutrient-info\">\n                        <div data-v-caee1139=\"\" className=\"nutrient-title\">\n                            {/* {t(\"home.text_banner1\")} */}\n                            {t(\"Mời bạn bè tham gia\")}\n                        </div>\n                        <div data-v-caee1139=\"\" className=\"nutrient-desc\">\n                            {/* {t(\"home.text_banner2\")} */}\n                            {t(\"Chia sẻ để nhận thêm phần thưởng\")}\n                        </div>\n                    </div>\n                    <div data-v-caee1139=\"\" className=\"nutrient-action\">\n                        <button\n                            data-v-caee1139=\"\"\n                            onClick={() => {\n                                setOpen(true)\n                            }}\n                            type=\"button\"\n                            className=\"van-button p-2 text-sm rounded-xl van-button--primary van-button--small van-button--round\"\n                        >\n                            <div className=\"van-button__content\">\n                                {/**/}\n                                <span className=\"van-button__text\">\n                                    {/* {t(\"home.learn_more\")} */}\n                                    {t(\"Mời bạn bè\")}\n                                </span>\n                                {/**/}\n                            </div>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </>\n    )\n}\n\nexport default NutientBanner","/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/home/PopupWelcome.tsx",[],[],"/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/home/TeamInvite.tsx",["303"],[],"import { Drawer, Tabs } from 'antd'\nimport requestService from 'api/request'\nimport { formatNumber } from 'lib/helpers'\nimport React, { useEffect, useState } from 'react'\nimport { useTranslation } from 'react-i18next'\nimport MemberItem from '../MemberItem'\nimport Empty from 'components/elements/Empty'\n\ninterface Props {\n    setOpen: (val: boolean) => void,\n    open: boolean,\n\n}\n\nconst TeamInvite = ({ open, setOpen }: Props) => {\n    const { t } = useTranslation()\n    const [summary, setSummary] = useState<any>()\n    const getSummaryTeam = async () => {\n        try {\n            const res = await requestService.get('/profile/summary-team')\n            if (res && res?.data) {\n                setSummary(res.data?.data)\n            }\n\n        } catch (error) {\n            console.log('====================================');\n            console.log(error);\n            console.log('====================================');\n        }\n    }\n\n    useEffect(() => {\n        getSummaryTeam()\n    }, [])\n    return (\n        <Drawer\n            title={\n                <div className='text-center'>\n                    {t(\"TEAM\")}\n                </div>\n            }\n            placement={'right'}\n            style={{\n                background: \"#fff\"\n            }}\n            closable={true}\n            closeIcon={\n                <div>\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5 hover:text-[#000]\">\n                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15.75 19.5 8.25 12l7.5-7.5\" />\n                    </svg>\n\n\n                </div>\n            }\n            onClose={() => setOpen(false)}\n            width=\"100VW\"\n            open={open}\n\n        >\n            <div data-v-d324c76e=\"\" className=\"team-page\">\n\n                <div data-v-d324c76e=\"\" className=\"team-header\">\n                    <div data-v-d324c76e=\"\" className=\"team-card\">\n                        <div data-v-d324c76e=\"\" className=\"team-overview\">\n                            <div data-v-d324c76e=\"\" className=\"total-count\">\n                                <span data-v-d324c76e=\"\" className=\"label\">\n                                    {t(\"Total team members\")}\n                                </span>\n                                <span data-v-d324c76e=\"\" className=\"value\">\n                                    {summary?.totalTeamMembers}\n                                </span>\n                            </div>\n                            <div data-v-d324c76e=\"\" className=\"level-counts\">\n                                <div data-v-d324c76e=\"\" className=\"level-item\">\n                                    <span data-v-d324c76e=\"\" className=\"value\">\n                                        {summary?.levelA?.length}\n                                    </span>\n                                    <span data-v-d324c76e=\"\" className=\"label\">\n                                        Level A\n                                    </span>\n                                </div>\n                                <div data-v-d324c76e=\"\" className=\"level-item\">\n                                    <span data-v-d324c76e=\"\" className=\"value\">\n                                        {summary?.levelB?.length}\n                                    </span>\n                                    <span data-v-d324c76e=\"\" className=\"label\">\n                                        Level B\n                                    </span>\n                                </div>\n                                <div data-v-d324c76e=\"\" className=\"level-item\">\n                                    <span data-v-d324c76e=\"\" className=\"value\">\n                                        {summary?.levelC?.length}\n                                    </span>\n                                    <span data-v-d324c76e=\"\" className=\"label\">\n                                        Level C\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div data-v-d324c76e=\"\" className=\"team-earnings\">\n                            <div data-v-d324c76e=\"\" className=\"earning-item\">\n                                <span data-v-d324c76e=\"\" className=\"value\">\n                                    {formatNumber(summary?.totalEarningValue?.toLocaleString())}\n                                </span>\n                                <span data-v-d324c76e=\"\" className=\"label\">\n                                    {t(\"Total earnings\")}\n                                </span>\n                            </div>\n                            <div data-v-d324c76e=\"\" className=\"earning-item\">\n                                <span data-v-d324c76e=\"\" className=\"value\">\n                                    {formatNumber(summary?.totalEarningValueToday?.toLocaleString())}\n                                </span>\n                                <span data-v-d324c76e=\"\" className=\"label\">\n                                    {t(\"Today's earnings\")}\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div data-v-d324c76e=\"\" className=\"team-content\">\n                    <Tabs\n                        defaultActiveKey=\"a\"\n\n                        className='tab-team'\n                        size='large'\n                        centered\n                        items={[\n                            {\n                                key: \"a\",\n                                label: \"Level A\",\n                                children: <div>\n                                    <div data-v-d324c76e=\"\" className=\"member-list\">\n                                        {\n                                            summary?.levelA?.map((i: any, index: number) => (\n                                                <MemberItem {...i} />\n                                            ))\n                                        }\n                                        {\n                                            !summary?.levelA?.length &&\n                                            <div className='text-center text-[#ccc]'>No Member</div>\n                                        }\n\n                                    </div>\n\n                                </div>,\n                            },\n                            {\n                                key: \"b\",\n                                label: \"Level B\",\n                                children: <div>\n                                    <div data-v-d324c76e=\"\" className=\"member-list\">\n                                        {\n                                            summary?.levelB?.map((i: any, index: number) => (\n                                                <MemberItem {...i} />\n                                            ))\n                                        }\n\n                                        {\n                                            !summary?.levelB?.length &&\n                                            <div className='text-center text-[#ccc]'>No Member</div>\n                                        }\n\n                                    </div>\n\n                                </div>,\n                            },\n                            {\n                                key: \"c\",\n                                label: \"Level C\",\n                                children: <div>\n                                    <div data-v-d324c76e=\"\" className=\"member-list\">\n                                        {\n                                            summary?.levelC?.map((i: any, index: number) => (\n                                                <MemberItem {...i} />\n                                            ))\n                                        }\n                                        {\n                                            !summary?.levelC?.length &&\n                                            <div className='text-center text-[#ccc]'>No Member</div>\n                                        }\n\n\n                                    </div>\n\n                                </div>,\n                            },\n                        ]}\n\n                    />\n\n                </div>\n\n            </div>\n\n        </Drawer>\n    )\n}\n\nexport default TeamInvite","/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/Withdraw.tsx",["304","305","306","307"],[],"import { Drawer, message, Modal } from 'antd'\nimport requestService from 'api/request'\nimport { clsx } from 'clsx'\nimport { formatNumber } from 'lib/helpers'\nimport React, { useEffect, useRef, useState } from 'react'\nimport { useTranslation } from 'react-i18next'\nimport { useAuthApp } from 'store/useAuthApp'\nimport { useGlobalAppStore } from 'store/useGlobalApp'\nimport { useCopyToClipboard } from \"@uidotdev/usehooks\";\nimport Countdown from 'react-countdown'\nimport { AddPaymentMethod } from './AddPaymentMethod'\nimport PinInput from 'react-pin-input'\n\ninterface Props {\n    setOpen: (val: boolean) => void,\n    open: boolean\n}\nconst Withdraw = ({ setOpen, open }: Props) => {\n    const { t } = useTranslation()\n    const { user } = useAuthApp()\n    const { configApp, handleLoading, handleCallbackUser } = useGlobalAppStore()\n    const [openAddMethod, setAddMethod] = useState(false)\n    const [openConfirm, setOpenConfirm] = useState(false)\n    const [_, copyToClipboard] = useCopyToClipboard();\n    const [amount, setAmount] = useState(0)\n    const [selectMethod, setSelectMethod] = useState(user?.bankList[0])\n    const pinRef = useRef<any>(null);\n\n    const handleReset = () => {\n        pinRef?.current?.clear(); // Reset input về trống\n    };\n    const reset = () => {\n        // setAddMethod(false)\n        setAmount(0)\n        setSelectMethod(user?.bankList[0])\n    }\n\n    useEffect(() => {\n        setSelectMethod(user?.bankList[0])\n    }, [user])\n\n    const handleWithdraw = async (paymentPassword: string) => {\n\n        handleLoading(true)\n        try {\n            const res = await requestService.post('/profile/withdraw', {\n                data: {\n                    amount,\n                    fiatAmount: amount * configApp?.rateUsdWithdraw,\n                    paymentMethod: JSON.stringify(selectMethod),\n                    note: \"WIDTHDRAW\" + Date.now(),\n                    paymentPassword\n                }\n            })\n            if (res && res.data) {\n                handleCallbackUser()\n                message.success(\"Withraw success!\")\n            }\n        } catch (error: any) {\n            console.log('====================================');\n            console.log(error);\n            console.log('====================================');\n\n            message.error(error?.response?.data?.message)\n        }\n        handleLoading(false)\n        handleReset()\n    }\n    return (\n        <>\n            <AddPaymentMethod\n                open={openAddMethod}\n                setOpen={setAddMethod}\n            />\n            <Drawer\n                title={\n                    <div className='text-center'>\n                        {t(\"home.withdraw\")}\n                    </div>\n                }\n                placement={'right'}\n                closable={true}\n                closeIcon={\n                    <div>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5 hover:text-[#000]\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15.75 19.5 8.25 12l7.5-7.5\" />\n                        </svg>\n\n\n                    </div>\n                }\n                onClose={() => {\n                    reset()\n                    setOpen(false)\n                }}\n                width=\"100VW\"\n                open={open}\n\n            >\n\n                <div data-v-0fbd6467=\"\" className=\"balance-card\">\n                    <div data-v-0fbd6467=\"\" className=\"label\">\n                        {t(\"Số dư có thể rút\")}\n                    </div>\n                    <div data-v-0fbd6467=\"\" className=\"amount\">\n                        <span data-v-0fbd6467=\"\" className=\"value\">\n                            {user?.realBalance?.toLocaleString()}\n                        </span>\n                        <span data-v-0fbd6467=\"\" className=\"currency\">\n                            $\n                        </span>\n                    </div>\n                </div>\n                <div data-v-7d13b5f8=\"\" className=\"amount-section\">\n                    <div data-v-7d13b5f8=\"\" className=\"section-title\">\n                        {t(\"Withdraw amount\")}\n                    </div>\n                    <div data-v-7d13b5f8=\"\" className=\"van-cell van-field\">\n                        {/**/}\n                        {/**/}\n                        <div className=\"van-cell__value van-field__value\">\n                            <div className=\"van-field__body gap-2\">\n                                <input\n                                    type=\"text\"\n                                    onChange={(e) => setAmount(parseFloat(e.target.value || \"0\"))}\n                                    value={amount}\n                                    inputMode=\"decimal\"\n                                    id=\"van-field-17-input\"\n                                    className=\"van-field__control van-field__control--right \n                                    !placeholder:text-[#dddd]\"\n                                    placeholder=\"0\"\n                                    data-allow-mismatch=\"attribute\"\n                                />\n                                {/**/}\n                                <div className=\"van-field__right-icon\">\n                                    <div data-v-7d13b5f8=\"\" className=\"right-content\">\n\n                                        <button\n                                            data-v-7d13b5f8=\"\"\n                                            type=\"button\"\n                                            className=\"van-button van-button--default van-button--small\"\n                                            onClick={() => setAmount(user?.realBalance || 0)}\n                                        >\n                                            <div className=\"van-button__content\">\n                                                {/**/}\n                                                <span className=\"van-button__text\">All</span>\n                                                {/**/}\n                                            </div>\n                                        </button>\n                                    </div>\n                                </div>\n                                {/**/}\n                            </div>\n                            {/**/}\n                            {/**/}\n                        </div>\n                        {/**/}\n                        {/**/}\n                    </div>\n                </div>\n                <div data-v-7d13b5f8=\"\" className=\"channel-section\">\n                    <div data-v-7d13b5f8=\"\" className=\"section-title\">\n                        <span data-v-7d13b5f8=\"\">\n                            {t(\"Select Bank Account\")}\n                        </span>\n                        <button\n                            data-v-7d13b5f8=\"\"\n                            type=\"button\"\n                            onClick={() => {\n                                setOpen(false)\n                                setTimeout(() => (\n                                    setAddMethod(true)\n                                ), 150)\n\n\n                            }}\n                            className=\"van-button van-button--primary van-button--small justify-end van-button--plain add-btn\"\n                        >\n                            <div className=\"van-button__content\">\n                                {/**/}\n                                <span className=\"van-button__text\">\n                                    {t(\"Add Bank\")}\n                                </span>\n                                {/**/}\n                            </div>\n                        </button>\n                    </div>\n                    <div data-v-7d13b5f8=\"\" className=\"channel-list\">\n                        {\n                            user && user?.bankList?.length > 0\n                            && user?.bankList?.map((i, index) => (\n                                <div data-v-7d13b5f8=\"\"\n                                    onClick={() => setSelectMethod(i)}\n                                    className={clsx(\"channel-item\", {\n                                        \"active\": i?.numberBank === selectMethod?.numberBank && i?.nameBank === selectMethod?.nameBank\n                                    })} key={index}>\n                                    <svg\n                                        data-v-7d13b5f8=\"\"\n                                        className=\"inline-block channel-icon\"\n                                        viewBox=\"0 0 24 24\"\n                                        width=\"1.2em\"\n                                        height=\"1.2em\"\n                                        style={{ color: \"rgb(7, 193, 96)\" }}\n                                    >\n                                        <path\n                                            fill=\"currentColor\"\n                                            d=\"M11.5 1L2 6v2h19V6m-5 4v7h3v-7M2 22h19v-3H2m8-9v7h3v-7m-9 0v7h3v-7z\"\n                                        />\n                                    </svg>\n                                    <span data-v-7d13b5f8=\"\">{i?.numberBank}({i?.nameBank})</span>\n                                    {\n                                        i?.nameBank === selectMethod?.nameBank && i?.numberBank === selectMethod?.numberBank\n                                            ?\n                                            <svg\n                                                data-v-0fbd6467=\"\"\n                                                className=\"inline-block check-icon\"\n                                                viewBox=\"0 0 24 24\"\n                                                width=\"1.2em\"\n                                                height=\"1.2em\"\n                                                style={{ color: \"var(--primary-color)\" }}\n                                            >\n                                                <path\n                                                    fill=\"currentColor\"\n                                                    d=\"m10 17l-5-5l1.41-1.42L10 14.17l7.59-7.59L19 8m0-5H5c-1.11 0-2 .89-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2\"\n                                                />\n                                            </svg>\n                                            :\n                                            <svg\n                                                data-v-0fbd6467=\"\"\n                                                className=\"inline-block check-icon\"\n                                                viewBox=\"0 0 24 24\"\n                                                width=\"1.2em\"\n                                                height=\"1.2em\"\n                                                style={{ color: \"rgb(238, 238, 238)\" }}\n                                            >\n                                                <path\n                                                    fill=\"currentColor\"\n                                                    d=\"M19 3H5c-1.11 0-2 .89-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2m0 2v14H5V5z\"\n                                                />\n                                            </svg>\n                                    }\n                                </div>\n                            ))\n\n                        }\n\n                    </div>\n\n                </div>\n                <div data-v-7d13b5f8=\"\" className=\"submit-section\">\n                    <button\n                        onClick={() => {\n                            // const now = new Date();\n                            // const vnNow = new Date(now.getTime() + (7 * 60 - now.getTimezoneOffset()) * 60000);\n                            // const hours = vnNow.getHours();\n\n                            // Nếu nằm trong khoảng 23:00 - 09:00 thì hiển thị thông báo và return\n                            // if (hours >= 23 || hours < 9) {\n                            //     return message.warning(\"System under maintenance, please try again later.\");\n                            // }\n                            if (!selectMethod) return message.warning(t(\"Bạn chưa cài đặt thanh toán\"))\n                            setOpenConfirm(true)\n                        }}\n                        data-v-7d13b5f8=\"\"\n                        disabled={!user || user.realBalance < amount || user.realBalance === 0}\n                        type=\"button\"\n                        className=\"w-full text-[#fff] van-button van-button--primary van-button--normal van-button--block\"\n                        style={{\n                            background: !user || user.realBalance < amount || user.realBalance === 0 ? \"#bbb\" : \"\"\n                        }}\n                    >\n                        <div className=\"van-button__content\">\n                            {/**/}\n                            <span className=\"van-button__text\">\n                                {t(\"Confirm withdrawal\")}\n                            </span>\n                            {/**/}\n                        </div>\n                    </button>\n                </div>\n\n                <div data-v-7d13b5f8=\"\" className=\"notice-section\">\n                    <div data-v-7d13b5f8=\"\" className=\"section-title\">\n                        {t(\"Withdrawal instructions\")}\n                    </div>\n                    <div data-v-7d13b5f8=\"\" className=\"notice-content\">\n                        {t(`1Số tiền rút tối thiểu: 2$`, {\n                            amount: configApp?.maxWithdraw\n                        })} <br />\n                        {t(\"2Thời gian đón hàng ngày\")}\n                        <br />\n                        {t(\"3quantrong_ruttien\")}\n                        <br />\n                        {t(\"Giới hạn rút USDT: 50,6USDT-10.000USDT (chỉ hỗ trợ mạng BEP20)\")}\n                        <br />\n                        {t(`meo`)}\n                    </div>\n                </div>\n\n\n            </Drawer>\n            <Drawer\n                open={openConfirm}\n                onClose={() => setOpenConfirm(false)}\n                placement='bottom'\n                height={\"40vh\"}\n                width={\"100vw\"}\n                zIndex={9999}\n                className='security'\n                closeIcon={false}\n                title={\n                    <div className='flex justify-between'>\n                        <div className='cursor-pointer ' >\n                            {t('Enter Payment Password')}\n                        </div>\n                        <div className='cursor-pointer' onClick={() => {\n                            // if (!!parseInt(configApp?.PAYMENT_MAINTENANCE))\n                            //     return message.warning(\"System under maintenance, please try again later.\")\n\n                            setOpenConfirm(false)\n\n\n                        }}>\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-6\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\" />\n                            </svg>\n\n                        </div>\n                    </div>\n                }\n            >\n                <div className='flex justify-center flex-col items-center '>\n                    <label>\n                        {t('home.amount')}\n                    </label>\n                    <div className='text-[5vw] font-[600]'>\n                        $ {formatNumber(amount)} = {formatNumber(amount * configApp?.rateUsdWithdraw)} vnđ\n                    </div>\n                </div>\n                <PinInput\n                    length={6}\n                    secret\n                    secretDelay={400}\n                    inputMode=\"numeric\"\n                    ref={pinRef}\n                    type=\"numeric\"\n                    style={{ padding: '10px', width: \"100%\", display: 'flex', justifyContent: 'center', gap: \"10px\" }}\n                    inputStyle={{ borderColor: '#1a9351' }}\n                    inputFocusStyle={{ borderColor: '#0f7c52' }}\n                    onComplete={async (value, index) => {\n                        handleReset()\n                        setOpenConfirm(false)\n                        await handleWithdraw(value)\n                    }}\n                    autoSelect={true}\n                    regexCriteria={/^[ A-Za-z0-9_@./#&+-]*$/}\n                />\n\n            </Drawer >\n        </>\n    )\n}\n\n\nexport default Withdraw",[],"/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/Deposit.tsx",["308","309","310","311"],[],"import { Drawer, message, Modal } from 'antd'\nimport requestService from 'api/request'\nimport { clsx } from 'clsx'\nimport { formatNumber } from 'lib/helpers'\nimport React, { useState } from 'react'\nimport { useTranslation } from 'react-i18next'\nimport { useAuthApp } from 'store/useAuthApp'\nimport { useGlobalAppStore } from 'store/useGlobalApp'\nimport { useCopyToClipboard } from \"@uidotdev/usehooks\";\nimport Countdown from 'react-countdown'\n\ninterface Props {\n    setOpen: (val: boolean) => void,\n    open: boolean\n}\nconst Deposit = ({ setOpen, open }: Props) => {\n    const { t } = useTranslation()\n    const { user } = useAuthApp()\n    const { configApp, handleLoading } = useGlobalAppStore()\n    const [paymentMethod, setPaymentMethod] = useState('crypto')\n    const [openConfirm, setOpenConfirm] = useState(false)\n    const [_, copyToClipboard] = useCopyToClipboard();\n    const [amount, setAmount] = useState(0)\n    const [resultDeposit, seResultDeposit] = useState<any>(null)\n\n    const reset = () => {\n        setOpenConfirm(false)\n        setAmount(0)\n        setPaymentMethod('crypto')\n        seResultDeposit(null)\n    }\n\n    const handleDeposit = async () => {\n        //return message.warning(\"System under maintenance, please try again later.\");\n        // const now = new Date();\n        // const vnNow = new Date(now.getTime() + (7 * 60 - now.getTimezoneOffset()) * 60000);\n        // const hours = vnNow.getHours();\n\n        // Nếu nằm trong khoảng 23:00 - 09:00 thì hiển thị thông báo và return\n        // if (hours >= 23 || hours < 9) {\n        //     return message.warning(\"System under maintenance, please try again later.\");\n        // }\n        if (!!parseInt(configApp?.PAYMENT_MAINTENANCE))\n            return message.warning(\"System under maintenance, please try again later.\")\n        handleLoading(true)\n        try {\n            const res = await requestService.post('/profile/deposit', {\n                data: {\n                    amount,\n                    fiatAmount: amount * configApp?.rateUsd || 26000,\n                    paymentMethod,\n                    note: \"MP\" + Date.now(),\n                }\n            })\n            if (res && res.data) {\n                setOpenConfirm(true)\n                seResultDeposit(res.data?.data)\n            }\n        } catch (error: any) {\n            console.log('====================================');\n            console.log(error);\n            console.log('====================================');\n            message.error(error?.respone?.data?.message)\n        }\n        handleLoading(false)\n    }\n    return (\n        <>\n\n            <Drawer\n                title={\n                    <div className='text-center'>\n                        {t(\"home.deposit\")}\n                    </div>\n                }\n                placement={'right'}\n                closable={true}\n                closeIcon={\n                    <div>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth={1.5} stroke=\"currentColor\" className=\"size-5 hover:text-[#000]\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15.75 19.5 8.25 12l7.5-7.5\" />\n                        </svg>\n\n\n                    </div>\n                }\n                onClose={() => {\n                    reset()\n                    setOpen(false)\n                }}\n                width=\"100VW\"\n                open={open}\n\n            >\n                <div data-v-0fbd6467=\"\" className=\"balance-card\">\n                    <div data-v-0fbd6467=\"\" className=\"label\">\n                        {t(\"Số dư có thể rút\")}\n                    </div>\n                    <div data-v-0fbd6467=\"\" className=\"amount\">\n                        <span data-v-0fbd6467=\"\" className=\"value\">\n                            {user?.realBalance?.toLocaleString()}\n                        </span>\n                        <span data-v-0fbd6467=\"\" className=\"currency\">\n                            $\n                        </span>\n                    </div>\n                </div>\n                {\n                    !openConfirm ?\n                        <>\n                            <div data-v-0fbd6467=\"\" className=\"amount-section\">\n                                <div data-v-0fbd6467=\"\" className=\"section-title\">\n                                    {t(\"Chọn số tiền\")}\n                                </div>\n                                <div className=\"amount-grid\" data-v-0fbd6467=\"\">\n                                    {[\n                                        \"5\", \"10\", \"20\",\n                                        \"50\", \"100\", \"200\",\n                                        \"500\", \"1000\", \"2000\"\n                                    ].map((amount, index) => (\n                                        <div\n                                            onClick={() => setAmount(+amount)}\n                                            data-v-0fbd6467=\"\" key={index} className=\"amount-item flex gap-2 items-center justify-center\">\n                                            <span data-v-0fbd6467=\"\" className=\"value\">{amount}</span>\n                                            <span data-v-0fbd6467=\"\" className=\"currency\">$</span>\n                                        </div>\n                                    ))}\n                                </div>\n\n\n                                <div data-v-0fbd6467=\"\" className=\"van-cell van-field flex flex-col\">\n                                    {/**/}\n                                    <div className=\"van-cell__title van-field__label\">\n                                        <label\n                                            id=\"van-field-1-label\"\n                                            htmlFor=\"van-field-1-input\"\n                                            data-allow-mismatch=\"attribute\"\n                                        >\n                                            {t(\"Số tiền tùy chỉnh\")}\n                                        </label>\n                                        {/**/}\n                                    </div>\n                                    <div className=\"van-cell__value van-field__value\">\n                                        <div className=\"van-field__body\">\n                                            <input\n                                                value={amount}\n                                                onChange={(e) => setAmount(parseFloat(e.target.value || '0'))}\n                                                type=\"text\"\n                                                inputMode=\"decimal\"\n                                                id=\"van-field-1-input\"\n                                                className=\"van-field__control van-field__control--right placeholder:text-[#cccc] text-left\"\n                                                placeholder=\"\"\n\n                                            />\n                                            {/**/}\n                                            <div className=\"van-field__right-icon\">\n                                                <div data-v-0fbd6467=\"\" className=\"right-content\">\n                                                    <span data-v-0fbd6467=\"\" className=\"currency-label\">\n                                                        $\n                                                    </span>\n                                                </div>\n                                            </div>\n                                            {/**/}\n                                        </div>\n                                        {/**/}\n                                        {/**/}\n                                    </div>\n                                    {/**/}\n                                    {/**/}\n                                    = {formatNumber(amount * configApp?.rateUsd || 26000)} vnđ\n                                </div>\n                            </div>\n                            <div data-v-0fbd6467=\"\" className=\"channel-section\">\n                                <div data-v-0fbd6467=\"\" className=\"section-title\">\n                                    {t(\"Cổng thanh toán\")}\n                                </div>\n                                <div data-v-0fbd6467=\"\" className=\"channel-list\">\n                                    <div data-v-0fbd6467=\"\" className={clsx(\"channel-item\", {\n                                        \"active\": paymentMethod === 'crypto'\n                                    })}\n                                        onClick={() => setPaymentMethod('crypto')}\n                                    >\n                                        <svg\n                                            data-v-0fbd6467=\"\"\n                                            className=\"inline-block channel-icon\"\n                                            viewBox=\"0 0 24 24\"\n                                            width=\"1.2em\"\n                                            height=\"1.2em\"\n                                            style={{ color: \"rgb(7, 193, 96)\" }}\n                                        >\n                                            <path\n                                                fill=\"currentColor\"\n                                                d=\"M11.5 1L2 6v2h19V6m-5 4v7h3v-7M2 22h19v-3H2m8-9v7h3v-7m-9 0v7h3v-7z\"\n                                            />\n                                        </svg>\n                                        <span data-v-0fbd6467=\"\">\n                                            {t(\"Giao dịch tiền mã hoá\")}\n                                        </span>\n                                        {\n      