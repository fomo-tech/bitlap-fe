[{"/Users/nguyenthanhloc/Documents/investment-fe/src/index.tsx":"1","/Users/nguyenthanhloc/Documents/investment-fe/src/reportWebVitals.ts":"2","/Users/nguyenthanhloc/Documents/investment-fe/src/App.tsx":"3","/Users/nguyenthanhloc/Documents/investment-fe/src/locale/i18n.ts":"4","/Users/nguyenthanhloc/Documents/investment-fe/src/api/request.ts":"5","/Users/nguyenthanhloc/Documents/investment-fe/src/store/useGlobalApp.ts":"6","/Users/nguyenthanhloc/Documents/investment-fe/src/hooks/useRealMobile.ts":"7","/Users/nguyenthanhloc/Documents/investment-fe/src/hooks/useBreakpoint.ts":"8","/Users/nguyenthanhloc/Documents/investment-fe/src/components/ui/SupportMobile.tsx":"9","/Users/nguyenthanhloc/Documents/investment-fe/src/components/elements/Loading.tsx":"10","/Users/nguyenthanhloc/Documents/investment-fe/src/routes/index.tsx":"11","/Users/nguyenthanhloc/Documents/investment-fe/src/store/useAuthApp.ts":"12","/Users/nguyenthanhloc/Documents/investment-fe/src/routes/WrapperRouteComponent.tsx":"13","/Users/nguyenthanhloc/Documents/investment-fe/src/layouts/MainTabbar.tsx":"14","/Users/nguyenthanhloc/Documents/investment-fe/src/layouts/MainHeader.tsx":"15","/Users/nguyenthanhloc/Documents/investment-fe/src/routes/PrivateRoutes.tsx":"16","/Users/nguyenthanhloc/Documents/investment-fe/src/lib/helpers.ts":"17","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/activity/DailyCheckin.tsx":"18","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/activity/index.tsx":"19","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/activity/LuckyWeel.tsx":"20","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/profile/index.tsx":"21","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/order/index.tsx":"22","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/home/index.tsx":"23","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/auth/index.tsx":"24","/Users/nguyenthanhloc/Documents/investment-fe/src/pages/vip/Vip.tsx":"25","/Users/nguyenthanhloc/Documents/in